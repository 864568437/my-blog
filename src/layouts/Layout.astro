      const navElForSemifull = document.getElementById("navbar");
      if (navElForSemifull) {
        const transparentMode = navElForSemifull.getAttribute("data-transparent-mode");

        if (transparentMode === "semifull") {
          // 重新调用初始化函数来重新绑定滚动事件
          if (
