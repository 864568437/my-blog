          } else {
            footer.classList.add("md:col-span-2", "xl:col-start-2", "xl:col-span-1");
          }
        }
      }
      // ===== 首页布局切换结束 =====

      // 同步 banner 文字覆盖层可见性
      const bannerTextOverlay = document.querySelector(".banner-home-text-overlay");
      if (bannerTextOverlay) {
        if (isHome) {
          bannerTextOverlay.classList.remove("hidden");
        } else {
          bannerTextOverlay.classList.add("hidden");
        }
      }

      // 同步导航栏透明模式
      const navEl = document.getElementById("navbar");
      if (navEl) {
        navEl.setAttribute("data-is-home", isHome.toString());
      }

      // Swup 转换后重新同步壁纸模式状态
      // 无论是否首页，都需要重新应用壁纸模式，因为 wallpaper-wrapper 等 DOM 元素被替换了
      import("@/utils/setting-utils").then(({ applyWallpaperModeToDocument }) => {
        const currentMode = (document.documentElement.getAttribute("data-wallpaper-mode") || "banner") as any;
        try { applyWallpaperModeToDocument(currentMode); } catch (e) { /* ignore */ }
      });

      // 首页 / 非首页的主内容位置复位（首页首屏为影像揭示层）
      if (isHome) {
        const mainContentEl = document.querySelector(".w-full.z-30.pointer-events-none") as HTMLElement | null;
        if (mainContentEl) {
          mainContentEl.style.position = "";
          mainContentEl.style.top = "";
          mainContentEl.style.marginTop = "";
          mainContentEl.style.zIndex = "";
