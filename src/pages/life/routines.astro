---
import { Icon } from "astro-icon/components";
import { marked } from "marked";
import PageHeader from "@/components/common/PageHeader.astro";
import RoutinesEditor from "@/components/edit/RoutinesEditor.svelte";
import { getEnabledRoutines } from "@/config/routinesConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const routinesList = getEnabledRoutines();

const lastUpdated = routinesList.find((e) => e.updatedAt)?.updatedAt
	? new Date(routinesList.find((e) => e.updatedAt)!.updatedAt)
	: undefined;

const entriesWithContent = routinesList.map((entry) => {
	const html = marked.parse(entry.body || "", {
		gfm: true,
		breaks: true,
	}) as string;
	return {
		...entry,
		htmlContent: html,
	};
});

const totalEntries = entriesWithContent.length;
---

<MainGridLayout title="日常规划" description="我的规划与思考">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">

      <!-- 页面页头：面包屑 + 标题 -->
      <PageHeader
        title="日常规划"
        eyebrow="Routines"
        variant="stacked"
        breadcrumbs={[
          { name: "生活", icon: "material-symbols:home-work-rounded" },
          { name: "日常规划", icon: "material-symbols:checklist" },
        ]}
      >
        <p class="text-sm text-neutral-500 dark:text-neutral-400">记录和规划生活中的各项事务</p>
      </PageHeader>

      <!-- 统计卡片 -->
      <div class="flex flex-wrap gap-3 mb-6">
        <div class="stat-pill">
          <span class="font-semibold">{totalEntries}</span>
          <span class="text-neutral-500 dark:text-neutral-400">项规划</span>
        </div>
        <div class="stat-pill">
          <span class="font-semibold">{lastUpdated?.toLocaleDateString("zh-CN") || "暂无"}</span>
          <span class="text-neutral-500 dark:text-neutral-400">最后更新</span>
        </div>
      </div>

      <!-- 日常规划编辑器 -->
      <div data-no-swup>
        <RoutinesEditor client:load />
      </div>

      <!-- 规划列表（容器 id 供 KV 动态刷新脚本重渲染） -->
      <div>
        {totalEntries === 0 ? (
          <div class="w-full p-12 text-center" id="routines-empty">
            <Icon name="material-symbols:checklist" class="text-5xl text-neutral-300 dark:text-neutral-600 mb-4" />
            <p class="text-neutral-500 dark:text-neutral-400">还没有日常规划</p>
          </div>
        ) : (
          <div class="routines-grid" id="routines-grid">
            {entriesWithContent.map((entry) => (
              <article class="routine-card">
                <div class="routine-card-header">
                  <div class="routine-icon-wrap">
                    <span class="text-xl">{entry.icon}</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h2 class="routine-title">{entry.name}</h2>
                      {entry.time && (
                        <span class="routine-time">{entry.time}</span>
                      )}
                    </div>
                    {entry.description && (
                      <p class="routine-desc">{entry.description}</p>
                    )}
                  </div>
                </div>
                <div class="routine-card-body">
                  <div class="routine-content">
                    <Fragment set:html={entry.htmlContent} />
                  </div>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>

    </div>
  </div>
</MainGridLayout>

<script>
  /* ========== 客户端动态刷新：从 KV 端点获取最新规划数据，整块重渲染 ==========
   * SSR 提供首屏（SEO），页面加载后 fetch /api/data/routines 实时更新。
   * 编辑器提交 KV 后秒级生效；fetch 失败静默回落 SSR 内容。
   * marked 在客户端渲染 body（与 SSR 参数一致：gfm + breaks）。
   */
  import { marked } from "marked";

  function escHtml(s: unknown): string {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function renderRoutineCard(entry: any): string {
    const html = marked.parse(entry.body || "", { gfm: true, breaks: true, async: false }) as string;
    return (
      '<article class="routine-card">' +
      '<div class="routine-card-header">' +
      '<div class="routine-icon-wrap"><span class="text-xl">' + escHtml(entry.icon) + "</span></div>" +
      '<div class="flex-1 min-w-0">' +
      '<div class="flex items-center gap-2 flex-wrap">' +
      '<h2 class="routine-title">' + escHtml(entry.name) + "</h2>" +
      (entry.time ? '<span class="routine-time">' + escHtml(entry.time) + "</span>" : "") +
      "</div>" +
      (entry.description ? '<p class="routine-desc">' + escHtml(entry.description) + "</p>" : "") +
      "</div></div>" +
      '<div class="routine-card-body"><div class="routine-content">' + html + "</div></div>" +
      "</article>"
    );
  }

  function applyRoutines(items: any[]) {
    const enabled = items.filter((e) => e.enabled !== false).sort((a, b) => (a.order || 0) - (b.order || 0));
    const grid = document.getElementById("routines-grid");
    const empty = document.getElementById("routines-empty");
    if (!grid && !empty) return;

    if (enabled.length === 0) {
      grid?.remove();
      if (!empty) {
        const wrap = document.createElement("div");
        wrap.className = "w-full p-12 text-center";
        wrap.id = "routines-empty";
        wrap.innerHTML =
          '<span class="text-5xl text-neutral-300 dark:text-neutral-600 mb-4 inline-block">📋</span><p class="text-neutral-500 dark:text-neutral-400">还没有日常规划</p>';
        (grid || empty)?.parentElement?.appendChild(wrap);
      }
      return;
    }

    if (!grid) {
      // SSR 空态 → 有数据：建 grid
      const newGrid = document.createElement("div");
      newGrid.className = "routines-grid";
      newGrid.id = "routines-grid";
      empty?.replaceWith(newGrid);
    }
    const target = document.getElementById("routines-grid");
    if (target) target.innerHTML = enabled.map(renderRoutineCard).join("");

    // 更新统计
    const pills = document.querySelectorAll(".stat-pill .font-semibold");
    if (pills[0]) pills[0].textContent = String(enabled.length);
    if (pills[1]) {
      const latest = enabled.find((e) => e.updatedAt)?.updatedAt;
      pills[1].textContent = latest
        ? new Date(latest).toLocaleDateString("zh-CN")
        : "暂无";
    }
  }

  function doRefresh() {
    fetch("/api/data/routines", { cache: "no-store" })
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data || !Array.isArray(data.items)) return;
        applyRoutines(data.items);
      })
      .catch((e) => console.warn("[routines] 动态更新失败，使用 SSR 数据:", e));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", doRefresh);
  } else {
    doRefresh();
  }
  document.addEventListener("astro:page-load", doRefresh);
  document.addEventListener("astro:after-swap", doRefresh);

  // KV 编辑提交后同帧重渲染
  if (!(window as any).__kvRoutinesBound) {
    (window as any).__kvRoutinesBound = true;
    document.addEventListener("kv:data-updated", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.type === "routines" && Array.isArray(detail?.data?.items)) {
        applyRoutines(detail.data.items);
      }
    });
  }
</script>

<!-- is:global：KV 动态刷新脚本用 innerHTML 重渲染卡片，客户端节点没有
     Astro scoped class，scoped 样式会失效。类名均为 routine-* 独占命名。 -->
<style is:global>
  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 2px solid #000;
    border-radius: 50px;
    font-size: 13px;
    color: var(--deep-text);
  }
  :root.dark .stat-pill {
    border-color: #3f3f46;
  }

  .routines-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .routine-card {
    border: 2px solid #000;
    border-radius: var(--radius-large);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  :root.dark .routine-card {
    border-color: #3f3f46;
  }
  .routine-card:hover {
    border-color: var(--primary);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }
  :root.dark .routine-card:hover {
    border-color: #fff;
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.06);
  }

  .routine-card-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.25rem 0;
  }

  .routine-icon-wrap {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--btn-plain-bg-hover);
    flex-shrink: 0;
  }
  :root.dark .routine-icon-wrap {
    background: oklch(0.18 0 0);
  }

  .routine-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--deep-text);
    margin: 0;
  }

  .routine-time {
    display: inline-block;
    padding: 1px 10px;
    border-radius: 9999px;
    background: var(--btn-plain-bg-hover);
    color: var(--primary);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  :root.dark .routine-time {
    background: oklch(0.18 0 0);
  }

  .routine-desc {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--content-meta);
    line-height: 1.5;
  }

  .routine-card-body {
    padding: 1rem 1.25rem 1.5rem;
    border-top: 1px solid var(--line-divider);
    margin-top: 0.75rem;
  }

  /* 正文样式 */
  .routine-content {
    color: var(--deep-text);
    line-height: 1.8;
    font-size: 0.9375rem;
  }

  .routine-content :global(h1),
  .routine-content :global(h2),
  .routine-content :global(h3) {
    color: var(--deep-text);
    font-weight: 600;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .routine-content :global(h1) { font-size: 1.15rem; }
  .routine-content :global(h2) { font-size: 1.05rem; }
  .routine-content :global(h3) { font-size: 0.95rem; }

  .routine-content :global(p) {
    margin-bottom: 0.75em;
  }

  .routine-content :global(ul),
  .routine-content :global(ol) {
    padding-left: 1.25em;
    margin-bottom: 0.75em;
  }

  .routine-content :global(li) {
    margin-bottom: 0.375em;
  }

  .routine-content :global(strong) {
    color: var(--primary);
    font-weight: 600;
  }

  .routine-content :global(blockquote) {
    border-left: 3px solid var(--primary);
    padding-left: 1em;
    margin-left: 0;
    color: var(--content-meta);
  }

  .routine-content :global(hr) {
    border: none;
    border-top: 1px solid var(--line-divider);
    margin: 1.25em 0;
  }

  @media (max-width: 640px) {
    .routine-card-header {
      padding: 1rem 1rem 0;
    }
    .routine-card-body {
      padding: 0.75rem 1rem 1.25rem;
    }
  }
</style>
