---
import { Icon } from "astro-icon/components";
import PageHeader from "@/components/common/PageHeader.astro";
import NotebooksEditor from "@/components/edit/NotebooksEditor.svelte";
import { getEnabledFolders, getFolderStats } from "@/config/notebooksConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const folders = getEnabledFolders();

const notebooks = folders.map((folder) => {
	const stats = getFolderStats(folder.slug);
	return {
		id: folder.slug,
		name: folder.name,
		cover: folder.cover,
		summary: folder.summary,
		entries: stats.count,
		updatedAt: stats.latestDate ? new Date(stats.latestDate) : new Date(0),
		selfPath: `/life/notebooks/${folder.slug}/`,
		folderName: folder.slug,
		coverSrc: folder.cover || null,
	};
});

const sortedNotebooks = [...notebooks].sort((a, b) => {
	const aTime = a.updatedAt instanceof Date ? a.updatedAt.getTime() : 0;
	const bTime = b.updatedAt instanceof Date ? b.updatedAt.getTime() : 0;
	return bTime - aTime;
});
---

<MainGridLayout title="笔记本" description="成长日记、学习复盘、灵感随笔">
	<!-- 页面页头：面包屑 + 标题 -->
	<PageHeader
		title="笔记本"
		eyebrow="Notebooks"
		variant="stacked"
		breadcrumbs={[
			{ name: "生活", icon: "material-symbols:home-work-rounded" },
			{ name: "笔记本", icon: "material-symbols:menu-book-rounded" },
		]}
	>
		<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">
			成长日记、学习复盘、灵感随笔
		</p>
	</PageHeader>

	<div data-no-swup>
		<NotebooksEditor client:load />
	</div>

	<div class="diary-page flex w-full flex-col gap-6">
		<!-- 笔记本网格（容器 id 供 KV 动态刷新脚本重渲染） -->
		<section>
			{sortedNotebooks.length === 0 ? (
				<div class="diary-empty" id="diary-empty">
					<div class="text-6xl mb-4">📖</div>
					<h3 class="text-xl font-semibold mb-2 text-[var(--text-color)]">还没有日记本</h3>
					<p class="text-sm text-[var(--content-meta)]">开始记录你的第一篇日记吧！</p>
					<div class="mt-6 p-4 rounded-xl bg-[var(--btn-regular-bg)] text-left text-sm">
						<p class="text-[var(--text-color)] mb-2">创建步骤：</p>
						<ol class="text-[var(--content-meta)] space-y-1 list-decimal list-inside">
							<li>点击侧边栏「编辑」进入编辑模式</li>
							<li>添加笔记本分类与笔记条目</li>
							<li>提交后实时生效</li>
						</ol>
					</div>
				</div>
			) : (
				<div class="diary-grid" id="diary-grid">
					{sortedNotebooks.map((book) => (
						<a
							href={book.selfPath}
							class="diary-notebook group"
						>
							{/* 封面图 */}
							<div class="diary-cover-img-area">
								{book.coverSrc ? (
									<img
										src={book.coverSrc}
										alt={book.name || "笔记本封面"}
										class="diary-cover-img"
										loading="lazy"
									/>
								) : (
									<div class="diary-cover-placeholder">
										<span class="diary-cover-placeholder-icon">📔</span>
									</div>
								)}
							</div>

							{/* 封面文字内容 */}
							<div class="diary-cover-text">
								{/* 标签 */}
								<div class="flex items-center gap-2 mb-2">
									<span class="px-2 py-0.5 rounded-full text-xs font-medium diary-cover-tag">
										笔记
									</span>
									<span class="text-xs diary-cover-meta">
										{book.entries} 篇
									</span>
								</div>

								{/* 笔记本名称 */}
								<h3 class="text-lg font-bold diary-cover-name">
									{book.name || "未命名笔记本"}
								</h3>

								{/* 描述 */}
								<p class="text-sm diary-cover-desc line-clamp-2 mt-1">
									{book.summary || "暂无描述"}
								</p>
							</div>

							{/* 底部信息条 */}
							<div class="diary-notebook-footer">
								<span class="text-xs">
									{book.updatedAt instanceof Date ? book.updatedAt.toISOString().split("T")[0] : "未更新"}
								</span>
								<Icon name="material-symbols:chevron-right-rounded" class="text-base transition-transform group-hover:translate-x-1" />
							</div>
						</a>
					))}
				</div>
			)}
		</section>

		<!-- 装饰页脚 -->
		<section class="text-center py-4">
			<p class="text-sm text-[var(--content-meta)] opacity-50">
				✨ 每一页都是成长的足迹
			</p>
		</section>
	</div>
</MainGridLayout>

<script>
	/* ========== 客户端动态刷新：从 KV 端点获取最新笔记本数据，整块重渲染 ==========
	 * SSR 提供首屏（SEO），页面加载后 fetch /api/data/notebooks 实时更新。
	 * 编辑器提交 KV 后秒级生效；fetch 失败静默回落 SSR 内容。
	 * stats（每本笔记数 + 最后更新）在客户端复刻 getFolderStats 计算。
	 * 注意：新增 folder 的详情页是构建期 getStaticPaths 产物，要等下次
	 * 部署才存在——列表实时，但点新 folder 可能 404（已知接受的限制）。
	 */
	function escHtml(s: unknown): string {
		return String(s ?? "")
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;");
	}

	function renderNotebookCard(folder: any, count: number, latestDate: string): string {
		const dateStr = latestDate ? new Date(latestDate).toISOString().split("T")[0] : "未更新";
		return (
			'<a href="/life/notebooks/' + encodeURIComponent(folder.slug) + '/" class="diary-notebook group">' +
			'<div class="diary-cover-img-area">' +
			(folder.cover
				? '<img src="' + escHtml(folder.cover) + '" alt="' + escHtml(folder.name || "笔记本封面") + '" class="diary-cover-img" loading="lazy" />'
				: '<div class="diary-cover-placeholder"><span class="diary-cover-placeholder-icon">📔</span></div>') +
			"</div>" +
			'<div class="diary-cover-text">' +
			'<div class="flex items-center gap-2 mb-2">' +
			'<span class="px-2 py-0.5 rounded-full text-xs font-medium diary-cover-tag">笔记</span>' +
			'<span class="text-xs diary-cover-meta">' + count + " 篇</span>" +
			"</div>" +
			'<h3 class="text-lg font-bold diary-cover-name">' + escHtml(folder.name || "未命名笔记本") + "</h3>" +
			'<p class="text-sm diary-cover-desc line-clamp-2 mt-1">' + escHtml(folder.summary || "暂无描述") + "</p>" +
			"</div>" +
			'<div class="diary-notebook-footer">' +
			'<span class="text-xs">' + dateStr + "</span>" +
			'<span class="text-base">›</span>' +
			"</div></a>"
		);
	}

	function applyNotebooks(folders: any[], notes: any[]) {
		const enabled = folders.filter((f) => f.enabled !== false);
		const section = document.querySelector(".diary-page section");
		if (!section) return;

		if (enabled.length === 0) {
			const grid = document.getElementById("diary-grid");
			if (grid) grid.innerHTML = "";
			return;
		}

		// 客户端复刻 getFolderStats：按 folder 字段统计 count + latestDate
		const statsMap = new Map();
		for (const n of notes || []) {
			const prev = statsMap.get(n.folder) || { count: 0, latest: "" };
			statsMap.set(n.folder, {
				count: prev.count + 1,
				latest: (n.updatedAt || "") > prev.latest ? (n.updatedAt || "") : prev.latest,
			});
		}

		const cards = enabled
			.map((f) => {
				const s = statsMap.get(f.slug) || { count: 0, latest: "" };
				return { f, ...s };
			})
			.sort((a, b) => new Date(b.latest || 0).getTime() - new Date(a.latest || 0).getTime());

		// 空态 → 有数据：替换空态为 grid
		let grid = document.getElementById("diary-grid");
		if (!grid) {
			const empty = document.getElementById("diary-empty");
			grid = document.createElement("div");
			grid.className = "diary-grid";
			grid.id = "diary-grid";
			if (empty) empty.replaceWith(grid);
			else section.prepend(grid);
		}
		grid.innerHTML = cards.map((c) => renderNotebookCard(c.f, c.count, c.latest)).join("");
	}

	function doRefresh() {
		fetch("/api/data/notebooks", { cache: "no-store" })
			.then((res) => (res.ok ? res.json() : null))
			.then((data) => {
				if (!data || !Array.isArray(data.folders)) return;
				applyNotebooks(data.folders, data.notes || []);
			})
			.catch((e) => console.warn("[notebooks] 动态更新失败，使用 SSR 数据:", e));
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", doRefresh);
	} else {
		doRefresh();
	}
	document.addEventListener("astro:page-load", doRefresh);
	document.addEventListener("astro:after-swap", doRefresh);

	// KV 编辑提交后同帧重渲染
	if (!(window as any).__kvNotebooksBound) {
		(window as any).__kvNotebooksBound = true;
		document.addEventListener("kv:data-updated", (e: Event) => {
			const detail = (e as CustomEvent).detail;
			if (detail?.type === "notebooks" && Array.isArray(detail?.data?.folders)) {
				applyNotebooks(detail.data.folders, detail.data.notes || []);
			}
		});
	}
</script>

<!-- is:global：KV 动态刷新脚本用 innerHTML 重渲染卡片，客户端节点没有
     Astro scoped class，scoped 样式会失效。类名均为 diary-* 独占命名。 -->
<style is:global>
	/* 日记本网格 — 等大卡片 */
	.diary-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.5rem;
	}

	/* 日记本卡片 */
	.diary-notebook {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		border-radius: var(--radius-xl);
		overflow: hidden;
		background: var(--card-bg);
		border: 1px solid var(--line-divider);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.diary-notebook:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
	}

	/* ===== 封面图区域 ===== */
	.diary-cover-img-area {
		position: relative;
		aspect-ratio: 2 / 1;
		overflow: hidden;
		background: linear-gradient(135deg, var(--card-bg) 0%, color-mix(in srgb, var(--primary) 8%, var(--card-bg)) 100%);
	}

	.diary-cover-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.diary-notebook:hover .diary-cover-img {
		transform: scale(1.06);
	}

	/* 无封面时的占位 */
	.diary-cover-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--card-bg) 0%, color-mix(in srgb, var(--primary) 12%, var(--card-bg)) 100%);
	}

	.diary-cover-placeholder-icon {
		font-size: 3.5rem;
		opacity: 0.35;
		transition: all 0.3s ease;
	}

	.diary-notebook:hover .diary-cover-placeholder-icon {
		opacity: 0.55;
		transform: scale(1.1);
	}

	/* ===== 封面文字 ===== */
	.diary-cover-text {
		position: relative;
		padding: 1.25rem 1.25rem 0.75rem;
	}

	.diary-cover-tag {
		background: color-mix(in srgb, var(--primary) 20%, transparent);
		color: var(--primary);
	}

	.diary-cover-meta {
		color: var(--content-meta);
	}

	.diary-cover-name {
		color: var(--text-color);
		line-height: 1.3;
	}

	.diary-notebook:hover .diary-cover-name {
		color: var(--primary);
	}

	.diary-cover-desc {
		color: var(--content-meta);
		line-height: 1.5;
	}

	/* ===== 底部信息条 ===== */
	.diary-notebook-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1.25rem;
		margin-top: auto;
		border-top: 1px solid var(--line-divider);
		color: var(--content-meta);
	}

	/* 空状态 */
	.diary-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 4rem 2rem;
		background: var(--card-bg);
		border: 2px dashed var(--line-divider);
		border-radius: var(--radius-3xl);
	}

	/* 行数限制 */
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
