---
import { getEntry, render } from "astro:content";
import Markdown from "@/components/common/Markdown.astro";
import MarkdownPageEditor from "@/components/edit/MarkdownPageEditor.svelte";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
const aboutText = aboutPost.body ?? "";
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <div data-no-swup>
                <!-- 服务端渲染 MDX（支持组件化内容），编辑模式下由编辑器的 hideDisplay 事件控制显隐 -->
                <div id="about-mdx-display">
                    <Markdown class="about-mdx-content markdown-content onload-animation">
                        <Content />
                    </Markdown>
                </div>
                <MarkdownPageEditor
                    client:only
                    filePath="src/content/spec/about.mdx"
                    pageKey="about"
                    pageName="关于页面"
                    initialContent={aboutText}
                    hideDisplay
                />
            </div>
        </div>
    </div>
</MainGridLayout>

<script is:inline>
    (function () {
        function syncAboutMdx(e) {
            var detail = e && e.detail;
            if (!detail || detail.pageKey !== "about") return;
            var el = document.getElementById("about-mdx-display");
            if (!el) return;
            el.style.display = detail.editing ? "none" : "";
        }
        window.addEventListener("edit:displayModeChange", syncAboutMdx);
        /* 页面刚加载时编辑器尚未挂载，默认显示服务端渲染内容 */
        window.dispatchEvent(new CustomEvent("edit:displayModeChange", { detail: { pageKey: "about", editing: false } }));
    })();
</script>
