---
import HomeBlinds from "@components/layout/HomeBlinds.astro";
import HomeDigest from "@components/layout/HomeDigest.astro";
import type { GetStaticPaths } from "astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: allBlogPosts.length });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainGridLayout>
	<div class="home-page">
		<!-- 首屏：双层影像揭示层（已承载原 HomeHero 的文字内容），
		     终幕放大到全屏后经水波纹 / 渐变衔接带过渡到资讯聚合层 -->
		<HomeBlinds />
		<!-- 资讯聚合层：左右组件栏 + 最新动态 + 最新文章 -->
		<HomeDigest posts={page.data} />
	</div>
</MainGridLayout>
