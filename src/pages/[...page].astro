---
import HomeBlinds from "@components/layout/HomeBlinds.astro";
import HomeDataLayer from "@components/layout/HomeDataLayer.astro";
import HomePortfolioShutterLayer from "@components/layout/HomePortfolioShutterLayer.astro";
import HomeTicker from "@components/layout/HomeTicker.astro";
import type { GetStaticPaths } from "astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: allBlogPosts.length });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainGridLayout>
	<div class="home-page">
		<!-- 首屏：双层影像揭示层（已承载原 HomeHero 的文字内容） -->
		<HomeBlinds />
		<!-- 过渡位：公告跑马灯，衔接影像层结束与站点数据层 -->
		<HomeTicker />
		<div class="home-data-stack">
			<HomeDataLayer />
			<HomePortfolioShutterLayer />
		</div>
	</div>
</MainGridLayout>
