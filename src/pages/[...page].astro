---
import HomeBlinds from "@components/layout/HomeBlinds.astro";
import type { GetStaticPaths } from "astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 首页为单页路由：rest 参数返回 undefined 生成根路径
export const getStaticPaths = (() => {
	return [{ params: { page: undefined } }];
}) satisfies GetStaticPaths;
---

<MainGridLayout>
	<div class="home-page">
		<!-- 首屏：双层影像揭示层（已承载原 HomeHero 的文字内容），
		     终幕放大到全屏后经水波纹 / 渐变衔接带过渡到资讯聚合层 -->
		<HomeBlinds />
		<!-- 终幕退场跑道：随滚动拉起 page-bg 幕布盖住 fixed 终幕图，
		     跑道走完页脚才可见（见 home-content.css 注释） -->
		<div class="home-content" id="home-afterglow" aria-hidden="true"></div>
	</div>
</MainGridLayout>
