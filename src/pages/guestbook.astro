---
import GuestbookChat from "@components/features/GuestbookChat.svelte";
import GuestbookChatFallback from "@components/features/GuestbookChatFallback.astro";
import Footer from "@components/layout/Footer.astro";
import Navbar from "@components/layout/Navbar.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import Layout from "@layouts/Layout.astro";
import { navBarConfig, siteConfig } from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

if (!siteConfig.pages.guestbook) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.guestbook);
const description = i18n(I18nKey.guestbookDescription);
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

const navLinks = navBarConfig.links.map((item) => {
	if (typeof item === "number") return LinkPresets[item];
	return item;
});
---

<Layout title={title} description={description}>
	<div
		id="top-row"
		class="z-50 pointer-events-none relative mx-auto"
		class:list={[
			"sticky top-0 left-0 right-0 z-80 pt-2.5",
			navbarWidthFull ? "w-full" : "w-full max-w-(--page-width) px-0 md:px-4",
		]}
	>
		<div id="navbar-wrapper" class="pointer-events-auto bg-transparent">
			<Navbar />
		</div>
	</div>

	<NavMenuPanel links={navLinks} />

	<div class="relative w-full" id="main-grid-wrapper">
		<div class="mx-auto max-w-5xl px-4 md:px-6" data-sidebar-position="none" id="main-grid">
			<div id="left-sidebar-dynamic" class="hidden transition-swup-main"></div>
			<div id="right-sidebar-dynamic" class="hidden transition-swup-main"></div>

			<main id="swup-container" class="transition-swup-main">
				<h1 class="sr-only">{title}</h1>
				<div id="content-wrapper" class="onload-animation">
					<div class="guestbook-page">
						<GuestbookChat client:only="svelte">
							<GuestbookChatFallback slot="fallback" />
						</GuestbookChat>
					</div>
				</div>
				<div class="footer onload-animation mt-16 pt-8 border-t">
					<Footer />
				</div>
			</main>
		</div>
	</div>
</Layout>
