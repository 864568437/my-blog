﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import FriendCard from "@components/features/FriendCard.astro";
import FriendRulesModal from "@components/features/FriendRulesModal.astro";
import FriendFailWindow from "@components/features/FriendFailWindow.astro";
import FriendFailTombstone from "@components/features/FriendFailTombstone.astro";
import { friendsPageConfig, getEnabledFriends, commentConfig } from "@/config";
import FriendsEditor from "@/components/edit/FriendsEditor.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PageHeader from "@/components/common/PageHeader.astro";

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 从 friendsConfig.ts 读取友链数据
const items = getEnabledFriends();

// 生成 inline JSON（完整字段），供失效分区客户端脚本按 fail_count 分组渲染
const friendListForInline = JSON.stringify(
	items.map((it) => ({
		name: it.title,
		link: it.siteurl,
		avatar: it.imgurl,
		desc: it.desc || "",
		siteshot: it.siteshot || "",
	}))
);

const allTags = [
	...new Set(items.flatMap((item) => item.tags || [])),
].sort();

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 页面标题和描述
const title = i18n(I18nKey.friends);
const description = i18n(I18nKey.friendsDescription);

// 本站信息整合文本（一键复制）
const _si = friendsPageConfig.siteInfo;
const siteInfoText = _si
	? `Hi~我已加贵站了，现在申请一下友链！\n\n{\n    title: "${_si.name}",\n    imgurl: "${_si.avatar}",\n    desc: "${_si.desc}",\n    siteurl: "${_si.url}",\n    tags: ["Blog"],\n}`
	: "";
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面页头：面包屑 + 标题 + 右侧操作 slot（友链申请按钮） -->
      <PageHeader
        title={title}
        eyebrow="Friends"
        variant="stacked"
        breadcrumbs={[{ name: title, icon: "material-symbols:group" }]}
      >
        {
          friendsPageConfig.applyLink && (
            <div class="friend-header-toolbar w-full flex justify-end">
              <button
                data-open-friend-rules
                class="edit-main-btn-style rounded-lg border border-neutral-900 dark:border-neutral-100 text-neutral-900 dark:text-neutral-100 hover:bg-neutral-900 hover:text-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-900 transition-colors duration-200 font-medium flex items-center gap-1.5 cursor-pointer"
                style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;border:1px solid rgba(0,0,0,0.9);background:transparent;color:rgba(0,0,0,0.9);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;line-height:1;height:32px;box-sizing:border-box;"
              >
                <Icon name="material-symbols:help-outline-rounded" class="text-base" />
                如何申请友链
              </button>
            </div>
          )
        }
      </PageHeader>

      <!-- 友链编辑器 -->
      <div data-no-swup>
        <FriendsEditor client:load />
      </div>

      <!-- 标签筛选 -->
      {
        items.length > 0 && (
          <friend-filter class="flex flex-wrap gap-2 mb-6">
            <button
              data-tag="all"
              class="btn-regular px-3 py-1.5 rounded-lg bg-(--primary) text-white dark:text-neutral-900 hover:bg-(--primary) transition-colors duration-200 text-sm font-medium"
            >
              {i18n(I18nKey.all)}
            </button>
            {allTags.map((tag) => (
              <button
                data-tag={tag}
                class="btn-regular px-3 py-1.5 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) transition-colors duration-200 text-sm font-medium"
              >
                {tag}
              </button>
            ))}
          </friend-filter>
        )
      }

      <!-- 友链网格 -->
      <div class="friends-grid" id="friends-grid">
        <div class="grid grid-cols-3 sm:grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-4 my-4">
        {
          items.map((item) => (
            <div class="friend-card" data-friend-id={item.siteurl} data-tags={item.tags?.join(",")}>
              <FriendCard
                title={item.title}
                href={item.siteurl}
                imgurl={item.imgurl}
                desc={item.desc}
                tags={item.tags}
                siteshot={item.siteshot || ""}
              />
            </div>
          ))
        }
        </div>
      </div>

      <!-- 失效暂留 + 友链墓碑（客户端拉 check-flink result.json 后按 fail_count 分组） -->
      <FriendFailWindow />
      <FriendFailTombstone />

      <Markdown class="mt-2">
        <Content />
      </Markdown>

      <!-- 友链申请指南：左侧本站信息 + 右侧注意事项 -->
      <section class="flink-guide mt-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
          <!-- 左侧：本站信息（单卡片 + 一键复制） -->
          {siteInfoText && (
            <div class="min-w-0 flex flex-col">
              <h3 class="flex items-center gap-2 text-sm font-semibold text-neutral-800 dark:text-neutral-200 mb-2.5">
                <span class="flink-guide-dot bg-(--primary)"></span>
                本站信息
              </h3>
              <div class="flink-panel-card flex-1">
                <button
                  class="flink-copy-btn flink-panel-copy"
                  data-copy={siteInfoText}
                  aria-label="复制全部信息"
                  title="一键复制"
                >
                  <Icon name="material-symbols:content-copy-outline-rounded" class="flink-copy-icon" />
                  <Icon name="material-symbols:check-rounded" class="flink-check-icon" />
                </button>
                <pre class="flink-code-text">{siteInfoText}</pre>
              </div>
            </div>
          )}

          <!-- 右侧：注意事项（卡片形式） -->
          {friendsPageConfig.notes && friendsPageConfig.notes.length > 0 && (
            <div class="min-w-0 flex flex-col">
              <h3 class="flex items-center gap-2 text-sm font-semibold text-neutral-800 dark:text-neutral-200 mb-2.5">
                <span class="flink-guide-dot bg-amber-500"></span>
                注意事项
              </h3>
              <div class="flink-panel-card flex-1">
                <div class="flex flex-col gap-1.5">
                  {friendsPageConfig.notes.map((item) => (
                    <div class="flex items-start gap-2 text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
                      <span class="flink-note-dot mt-1.5"></span>
                      <p><strong class="text-neutral-800 dark:text-neutral-200">{item.title}</strong>：{item.content}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      </section>
    </div>
  </div>

  <!-- 评论区 -->
  <div class="mt-4 relative" id="post-comments">
    {isCommentEnabled && (
      <button
        id="flink-import-template-btn"
        class="absolute -top-1 right-2 z-20 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 text-xs font-medium hover:opacity-85 transition-opacity cursor-pointer"
      >
        <Icon name="material-symbols:drive-folder-upload-outline" class="text-sm" />
        一键导入模板
      </button>
    )}
    <Comment post={friendsPost} customPath="/friends/" />
  </div>

  <!-- 友链申请指南弹窗 -->
  <FriendRulesModal applyLink={friendsPageConfig.applyLink} commentEnabled={isCommentEnabled} />

  <script slot="head" is:inline>
    if (!customElements.get("friend-filter")) {
      class FriendFilter extends HTMLElement {
        constructor() {
          super();
        }

        connectedCallback() {
          this.addEventListener("click", this.handleClick);
        }

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
        }

        handleClick(e) {
          const target = e.target;
          const button = target.closest("button");
          if (!button) return;

          const selectedTag = button.dataset.tag;
          const filters = this.querySelectorAll("button");
          const container = this.closest(".card-base");
          if (!container) return;

          const cards = container.querySelectorAll(".friend-card");

          filters.forEach((f) => {
            f.classList.remove("bg-(--primary)", "text-white", "dark:text-neutral-900");
            f.classList.remove("hover:bg-(--primary)");
            f.classList.add(
              "bg-(--btn-regular-bg)",
              "text-(--btn-content)"
            );
            f.classList.add("hover:bg-(--btn-regular-bg-hover)");

            if (f === button) {
              f.classList.remove(
                "bg-(--btn-regular-bg)",
                "text-(--btn-content)"
              );
              f.classList.remove("hover:bg-(--btn-regular-bg-hover)");
              f.classList.add("bg-(--primary)", "text-white", "dark:text-neutral-900");
              f.classList.add("hover:bg-(--primary)");
            }
          });

          cards.forEach((card) => {
            const cardEl = card;
            const tags = (cardEl.dataset.tags || "").split(",");
            if (
              selectedTag === "all" ||
              (selectedTag && tags.includes(selectedTag))
            ) {
              cardEl.style.display = "";
              cardEl.classList.add("animate-fade-in-up");
            } else {
              cardEl.style.display = "none";
              cardEl.classList.remove("animate-fade-in-up");
            }
          });
        }
      }
      customElements.define("friend-filter", FriendFilter);
    }

    // 友链申请指南 - 复制按钮
    function initFlinkCopyButtons() {
      document.querySelectorAll(".flink-copy-btn").forEach((btn) => {
        if (btn.dataset.copyInit) return;
        btn.dataset.copyInit = "1";
        btn.addEventListener("click", () => {
          const text = btn.getAttribute("data-copy") || "";
          navigator.clipboard.writeText(text).then(() => {
            btn.classList.add("copied");
            setTimeout(() => btn.classList.remove("copied"), 1500);
          });
        });
      });
    }

    // 一键导入友链模板到评论区
    function initFlinkImportTemplate() {
      const btn = document.getElementById("flink-import-template-btn");
      if (!btn || btn.dataset.importInit) return;
      btn.dataset.importInit = "1";
      btn.addEventListener("click", () => {
        const template = 'Hi~我已加贵站了，现在申请一下友链！\n\n{\n    title: "站点名称",\n    imgurl: "头像链接",\n    desc: "站点描述",\n    siteurl: "站点链接",\n    linkpage: "友链页面,\n    tags: ["Blog"],\n },';
        // 查找评论系统输入框（Twikoo / Waline / Artalk）
        const textarea =
          document.querySelector("#tcomment .tk-textarea") ||
          document.querySelector("#tcomment textarea") ||
          document.querySelector(".wl-editor textarea") ||
          document.querySelector(".wl-editor") ||
          document.querySelector("#post-comments textarea");
        if (textarea) {
          if (textarea.tagName === "TEXTAREA" || textarea.tagName === "INPUT") {
            textarea.value = template;
            textarea.dispatchEvent(new Event("input", { bubbles: true }));
            textarea.focus({ preventScroll: true });
          } else {
            // contenteditable 元素
            textarea.innerText = template;
            textarea.dispatchEvent(new Event("input", { bubbles: true }));
            textarea.focus({ preventScroll: true });
          }
          textarea.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          // 输入框未加载时复制到剪贴板
          navigator.clipboard.writeText(template);
          const orig = btn.innerHTML;
          btn.textContent = "已复制到剪贴板";
          setTimeout(() => { btn.innerHTML = orig; }, 1500);
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => { initFlinkCopyButtons(); initFlinkImportTemplate(); });
    } else {
      initFlinkCopyButtons();
      initFlinkImportTemplate();
    }
    document.addEventListener("astro:page-load", () => { initFlinkCopyButtons(); initFlinkImportTemplate(); });
    document.addEventListener("astro:after-swap", () => { initFlinkCopyButtons(); initFlinkImportTemplate(); });
  </script>

  <script set:html={`window.__FRIEND_LIST__ = ${friendListForInline};`}></script>

  <script>
    /* ========== 三区互不重复分组：正常友链 / 失效暂留 / 友链墓碑 ==========
     * 数据流：总友链 = window.__FRIEND_LIST__（来自 friendsConfig.ts SSR 注入）
     *       叠加 result.json 的 fail_count 字段
     * 分组规则：
     *   fail_count === 0     → 正常友链（保留显示在 #friends-grid）
     *   fail_count ∈ [1, 6]  → 失效暂留（从正常区隐藏 + 渲染到 #friend-fail-window）
     *   fail_count ≥ 7       → 友链墓碑（从正常区隐藏 + 渲染到 #friend-fail-tombstone）
     * 保证三区互不重复。
     */
    (function () {
      const FZ_CACHE_KEY = "checkFlinkResultCache_v1";
      const FZ_CACHE_TTL = 30 * 60 * 1000;
      const FAIL_WINDOW = [1, 6];
      const TOMBSTONE = [7, 9999];
      const DATA_URL = "https://check.fqzlr.com/result.json";

      function normalizeUrl(u) {
        return (u || "").replace(/\/$/, "").trim();
      }
      function inRange(n, range) {
        const [min, max] = range;
        return n >= min && n <= max;
      }
      function readCache() {
        try {
          const raw = localStorage.getItem(FZ_CACHE_KEY);
          if (!raw) return null;
          const p = JSON.parse(raw);
          if (!p || !p.data || !p.ts) return null;
          if (Date.now() - p.ts > FZ_CACHE_TTL) return null;
          return p.data;
        } catch { return null; }
      }
      function writeCache(data) {
        try { localStorage.setItem(FZ_CACHE_KEY, JSON.stringify({ data, ts: Date.now() })); } catch {}
      }
      function faviconUrl(host) {
        if (!host) return inlineSvgUrl("?");
        return "https://www.google.com/s2/favicons?domain=" + encodeURIComponent(host) + "&sz=64";
      }
      function hostOf(url) {
        try { return new URL(url).host.replace(/^www\./, ""); } catch { return ""; }
      }
      function escapeHtml(s) {
        const map: Record<string, string> = {
          "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
        };
        return String(s == null ? "" : s).replace(/[&<>"']/g, (c: string) => map[c]);
      }
      // 头像三级容错链：博主提供 → dicebear → 内联 SVG（永远不失败）
      function dicebearUrl(name) {
        const s = (name || "guest").trim().toLowerCase();
        return "https://api.dicebear.com/7.x/notionists/svg?seed=" + encodeURIComponent(s);
      }
      function inlineSvgUrl(name) {
        const text = (name || "?").trim().slice(0, 1).toUpperCase() || "?";
        const hash = Array.from(text).reduce<number>((acc, ch) => (acc * 31 + (ch as string).charCodeAt(0)) >>> 0, 0);
        const hue = hash % 360;
        const bg = "hsl(" + hue + ", 55%, 55%)";
        const svg =
          '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80">' +
          '<rect width="80" height="80" fill="' + bg + '"/>' +
          '<text x="50%" y="50%" text-anchor="middle" dominant-baseline="central" ' +
          'font-family="-apple-system,Segoe UI,Roboto,sans-serif" font-weight="700" ' +
          'font-size="40" fill="#fff">' + text + '</text>' +
          '</svg>';
        return "data:image/svg+xml;utf8," + encodeURIComponent(svg);
      }
      function pickAvatar(link, avatar, host, name) {
        return avatar || dicebearUrl(name);
      }

      // 渲染"失效暂留" - 4 列横向小卡（样式对齐 prototype）
      function renderFailWindow(items) {
        const sec = document.getElementById("friend-fail-window");
        const body = sec?.querySelector("[data-ffz-body]");
        const sub = sec?.querySelector("[data-ffz-sub]");
        const badge = sec?.querySelector("[data-ffz-badge]");
        if (!sec || !body) return;
        if (!items.length) { sec.classList.add("hidden"); return; }
        sec.classList.remove("hidden");
        if (sub) sub.textContent = "这里有 " + items.length + " 个正在发光的小站点。";
        if (badge) badge.textContent = items.length + " sites";
        body.innerHTML = items.map((it) => {
          const host = hostOf(it.link);
          const avatar = pickAvatar(it.link, it.avatar, host, it.name);
          return (
            '<a class="fail-card" role="listitem" href="' + escapeHtml(it.link) + '" target="_blank" rel="noopener noreferrer" title="' + escapeHtml(it.name) + '">' +
              '<img class="fail-card-avatar" loading="lazy" decoding="async" src="' + escapeHtml(avatar) + '" alt="' + escapeHtml(it.name) + '" onerror="this.classList.add(\'is-error\');this.onerror=null;this.src=\'' + escapeHtml(faviconUrl(host)) + '\'" />' +
              '<div class="fail-card-text">' +
                '<div class="fail-card-name">' + escapeHtml(it.name) + '</div>' +
                '<div class="fail-card-host">' + escapeHtml(host) + '</div>' +
              '</div>' +
            '</a>'
          );
        }).join("");
      }

      // 渲染"友链墓碑" - 横向多列头像墙（样式对齐 prototype）
      function renderTombstone(items) {
        const sec = document.getElementById("friend-fail-tombstone");
        const wall = sec?.querySelector("[data-fft-wall]");
        if (!sec || !wall) return;
        if (!items.length) { sec.classList.add("hidden"); return; }
        sec.classList.remove("hidden");
        wall.innerHTML = items.map((it) => {
          const host = hostOf(it.link);
          const userAvatar = it.avatar || "";
          const dicebear = dicebearUrl(it.name);
          const initialSrc = userAvatar || dicebear;
          const dicebearAttr = userAvatar ? dicebear : "";
          const inlineAttr = inlineSvgUrl(it.name);
          return (
            '<span class="tomb-chip" role="listitem" title="' + escapeHtml(it.name) + '">' +
              '<img class="tomb-avatar" loading="lazy" decoding="async" ' +
                'src="' + escapeHtml(initialSrc) + '" ' +
                'alt="' + escapeHtml(it.name) + '" ' +
                'data-dicebear="' + escapeHtml(dicebearAttr) + '" ' +
                'data-fb-inline="' + escapeHtml(inlineAttr) + '" ' +
                'onerror="var d=this.dataset;if(d.fb1Used!==\'1\'&&d.dicebear){d.fb1Used=\'1\';var s=this;this.onerror=function(){s.onerror=null;s.src=d.fbInline;};this.src=d.dicebear;}else{this.onerror=null;this.src=d.fbInline;}" />' +
              '<span class="tomb-name">' + escapeHtml(it.name) + '</span>' +
            '</span>'
          );
        }).join("");
      }

      /**
       * 核心分组 + 渲染
       * 互不重复：每个友链按 fail_count 落入唯一分组
       *   0 → 正常区（保留 .friend-card 显示）
       *   1-6 → 失效暂留（先隐藏 .friend-card，再渲染到 ffz-body）
       *   ≥7 → 友链墓碑（先隐藏 .friend-card，再渲染到 fft-wall）
       */
      function applyData(data) {
        const list = (data && Array.isArray(data.link_status)) ? data.link_status : [];
        // 1) 构建 link→fail_count map
        const failMap = new Map();
        for (const it of list) {
          if (it && it.link) failMap.set(normalizeUrl(it.link), Number(it.fail_count || 0));
        }

        // 2) 总友链数据（来自 SSR 注入）
        const friendList = Array.isArray((window as any).__FRIEND_LIST__) ? (window as any).__FRIEND_LIST__ : [];
        const friendByLink = new Map();
        for (const f of friendList) {
          if (f && f.link) friendByLink.set(normalizeUrl(f.link), f);
        }

        // 3) 遍历正常区 .friend-card：分类
        const failList: any[] = [];   // 失效暂留
        const tombList: any[] = [];   // 友链墓碑
        const grid = document.getElementById("friends-grid");
        if (grid) {
          const cards = grid.querySelectorAll(".friend-card[data-friend-id]");
          cards.forEach((cardEl) => {
            const link = cardEl.getAttribute("data-friend-id") || "";
            const fc = failMap.get(normalizeUrl(link)) || 0;
            const friend = friendByLink.get(normalizeUrl(link)) || { name: link, link };
            if (inRange(fc, FAIL_WINDOW)) {
              // 失效暂留：从正常区隐藏 + 加入 failList
              (cardEl as HTMLElement).style.display = "none";
              failList.push({ ...friend, link, fail_count: fc });
            } else if (inRange(fc, TOMBSTONE)) {
              // 友链墓碑：从正常区隐藏 + 加入 tombList
              (cardEl as HTMLElement).style.display = "none";
              tombList.push({ ...friend, link, fail_count: fc });
            } else {
              // fail_count === 0：保留显示（正常友链）
              // 可选：更新 .friend-status 徽章
              (cardEl as HTMLElement).style.display = "";
            }
          });
        }

        // 4) 按 fail_count 降序排序
        const sortDesc = (a, b) => (b.fail_count || 0) - (a.fail_count || 0);
        failList.sort(sortDesc);
        tombList.sort(sortDesc);

        // 5) 渲染失效暂留 + 友链墓碑
        renderFailWindow(failList);
        renderTombstone(tombList);
      }

      async function init() {
        // 非友链页不执行
        if (!document.getElementById("friend-fail-window")) return;

        // 1) 先用缓存快速渲染（避免闪烁）
        const cached = readCache();
        if (cached) applyData(cached);

        // 2) 后台拉取最新数据
        try {
          const res = await fetch(DATA_URL, { cache: "no-store" });
          if (!res.ok) throw new Error("HTTP " + res.status);
          const data = await res.json();
          writeCache(data);
          applyData(data);
        } catch (err) {
          console.warn("[friend-zones] 拉取失败，使用缓存：", err);
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
      document.addEventListener("astro:page-load", init);
      document.addEventListener("astro:after-swap", init);
    })();
  </script>

  <script>
    /* ========== 客户端动态更新：从 friends.json.ts 端点获取最新数据，更新网格 ==========
     * SSR 渲染提供初始数据（SEO + 首屏），页面加载后通过此脚本实时更新。
     * 当 FriendsEditor.svelte 提交变更到 GitHub 后，下一次刷新即可看到最新数据。
     */
    (function refreshFriendsGrid() {
      async function doRefresh() {
        try {
          const res = await fetch("/friends.json", { cache: "no-store" });
          if (!res.ok) return;
          const data = await res.json();
          const grid = document.getElementById("friends-grid");
          if (!grid || !Array.isArray(data.link_list)) return;

          const latestMap = new Map();
          data.link_list.forEach(function (f) {
            var key = (f.link || "").replace(/\/$/, "");
            latestMap.set(key, f);
          });

          // 更新现有卡片：名称、头像、描述、链接
          grid.querySelectorAll(".friend-card[data-friend-id]").forEach(function (card) {
            var link = (card.getAttribute("data-friend-id") || "").replace(/\/$/, "");
            var latest = latestMap.get(link);
            if (!latest) return;

            // 更新 <a> 链接
            var anchor = card.tagName === "A" ? card : card.querySelector("a");
            if (anchor && latest.link) {
              (anchor as HTMLAnchorElement).href = latest.link;
            }

            // 更新头像
            var img = card.querySelector("img");
            if (img && latest.avatar) {
              img.src = latest.avatar;
            }

            // 更新标题
            var titleEl = card.querySelector(".font-bold");
            if (titleEl && latest.name) {
              titleEl.textContent = latest.name;
            }

            // 更新描述
            var descEl = card.querySelector(".text-sm.text-neutral-500");
            if (descEl && latest.descr) {
              descEl.textContent = latest.descr;
            }
          });

          // 更新 window.__FRIEND_LIST__（供失效分区脚本使用）
          if (Array.isArray(data.link_list)) {
            (window as any).__FRIEND_LIST__ = data.link_list.map(function (f) {
              return {
                name: f.name,
                link: f.link,
                avatar: f.avatar,
                desc: f.descr || "",
                siteshot: f.siteshot || "",
              };
            });
          }
        } catch (e) {
          console.warn("[friends] 动态更新失败，使用 SSR 数据:", e);
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", doRefresh);
      } else {
        doRefresh();
      }
      document.addEventListener("astro:page-load", doRefresh);
      document.addEventListener("astro:after-swap", doRefresh);
    })();
  </script>

  <script>
    /* ========== 悬停卡片浮出主页截图预览（跟随鼠标） ==========
     * 数据源：Layout.astro 的 renderLinkStatus() 从 check-flink result.json 注入的
     *         data-siteshot 属性（与卡片内嵌截图共用同一数据流，不新增依赖）。
     * 仅精确指针设备启用；预览层 pointer-events:none 不阻塞卡片交互。
     *
     * 【关键】preview div 通过 document.body.appendChild 挂载到 body 末尾，
     * 不属于 Swup 容器，跨页面切换不会被销毁。
     * 样式必须放在全局 CSS（src/styles/components/friend-image-preview.css），
     * 否则离开友链页后该 div 失去 position/opacity 等样式，
     * 会落到 body 文档流中暴露已加载的图片作为"页面背景"。
     * 即便样式已全局化，这里也在每次 Swup 切换前主动清空图片 src 并隐藏，
     * 形成双重保险，避免任何时序竞态。
     */
    (function initFriendImagePreview() {
      if ((window as any).__friendImagePreviewReady) return;
      (window as any).__friendImagePreviewReady = true;

      if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;

      var preview = document.createElement("div");
      preview.className = "friend-image-preview";
      preview.setAttribute("aria-hidden", "true");
      var previewImg = document.createElement("img");
      previewImg.alt = "";
      previewImg.decoding = "async";
      preview.appendChild(previewImg);
      document.body.appendChild(preview);

      var GAP = 16;

      // 完全清理：移除 is-visible + 清空图片 src（释放解码缓存，避免过渡瞬间残影）
      function hardHide() {
        preview.classList.remove("is-visible");
        // 把位置移到屏幕外，配合全局 visibility:hidden 双重保险
        try {
          preview.style.left = "-9999px";
          preview.style.top = "-9999px";
        } catch (_) { /* ignore */ }
      }

      function place(x, y) {
        var rect = preview.getBoundingClientRect();
        var vw = window.innerWidth;
        var vh = window.innerHeight;
        // 优先显示在鼠标右下方，空间不足时翻转到左侧/收进视口
        var left = x + GAP;
        var top = y + GAP;
        if (left + rect.width > vw - 8) left = x - rect.width - GAP;
        if (top + rect.height > vh - 8) top = Math.max(8, vh - rect.height - 8);
        preview.style.left = left + "px";
        preview.style.top = top + "px";
      }

      function show(card, x, y) {
        var src = card.dataset.siteshot;
        if (!src) return;
        if (previewImg.getAttribute("src") !== src) previewImg.src = src;
        preview.classList.add("is-visible");
        place(x, y);
      }

      function hide() {
        preview.classList.remove("is-visible");
      }

      document.addEventListener("mouseover", function (e) {
        var target = e.target;
        var card = target instanceof Element ? target.closest("[data-siteshot]") : null;
        if (card && card instanceof HTMLElement) {
          show(card, e.clientX, e.clientY);
        }
      });

      document.addEventListener("mouseout", function (e) {
        var target = e.target;
        var card = target instanceof Element ? target.closest("[data-siteshot]") : null;
        if (!card) return;
        var to = e.relatedTarget;
        // 卡片内部移动不隐藏
        if (to instanceof Element && to.closest("[data-siteshot]") === card) return;
        hide();
      });

      document.addEventListener("mousemove", function (e) {
        if (!preview.classList.contains("is-visible")) return;
        place(e.clientX, e.clientY);
      });

      // 页面切换前/后立即隐藏，避免 Swup 过渡期间（main-grid opacity 0.01）
      // 预览图片以"页面背景"形式暴露在 body 末尾
      document.addEventListener("astro:before-swap", hardHide);
      document.addEventListener("astro:after-swap", hardHide);
      document.addEventListener("astro:page-load", hardHide);
    })();
  </script>

