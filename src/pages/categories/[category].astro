---
import { render } from "astro:content";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import PageHeader from "@/components/common/PageHeader.astro";
import AnimatedTabs from "@/components/controls/AnimatedTabs.svelte";
import ArticleVirtualList from "@/components/pages/ArticleVirtualList.svelte";
import { siteConfig } from "@/config";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import { getCategoryList } from "@/utils/content-utils";
import {
	getApiUrlList,
	processCoverImageSync,
	shouldAddNoReferrer,
} from "@/utils/image-utils";
import {
	getCategoryPageUrl,
	getCategoryUrl,
	getFileDirFromPath,
	getPostUrlBySlug,
	getTagUrl,
	url,
} from "@/utils/url-utils";

type PostEntry = CollectionEntry<"posts">;

export const getStaticPaths = (async () => {
	const categories = await getCategoryList();
	const allPosts = await getCollection<"posts">("posts", ({ data }) => {
		return import.meta.env.PROD ? data.draft !== true : true;
	});

	const paths: {
		params: { category: string };
		props: {
			categoryName: string;
			posts: PostEntry[];
			totalPosts: number;
			tags: { name: string; count: number }[];
		};
	}[] = [];

	for (const category of categories) {
		const categoryPosts = allPosts.filter((post) => {
			const postCategory = post.data.category?.trim() || "";
			const uncategorized = i18n(I18nKey.uncategorized).toLowerCase();

			if (!category.name || category.name.toLowerCase() === uncategorized) {
				return !postCategory || postCategory.toLowerCase() === uncategorized;
			}
			return postCategory === category.name;
		});

		categoryPosts.sort((a, b) => {
			if (a.data.pinned && !b.data.pinned) return -1;
			if (!a.data.pinned && b.data.pinned) return 1;
			return (
				new Date(b.data.published).getTime() -
				new Date(a.data.published).getTime()
			);
		});

		const tagCountMap: Record<string, number> = {};
		categoryPosts.forEach((post) => {
			(post.data.tags || []).forEach((tag) => {
				tagCountMap[tag] = (tagCountMap[tag] || 0) + 1;
			});
		});
		const tags = Object.entries(tagCountMap)
			.sort((a, b) => b[1] - a[1])
			.map(([name, count]) => ({ name, count }));

		paths.push({
			params: { category: category.name },
			props: {
				categoryName: category.name,
				posts: categoryPosts,
				totalPosts: categoryPosts.length,
				tags,
			},
		});
	}

	return paths;
}) satisfies GetStaticPaths;

const { categoryName } = Astro.props;
const { posts, totalPosts, tags } = Astro.props;

const decodedCategory = decodeURIComponent(categoryName);

const dateFormatter = new Intl.DateTimeFormat(
	siteConfig.lang.replace("_", "-"),
	{ year: "numeric", month: "2-digit", day: "2-digit" },
);

const articleImageFiles = import.meta.glob<ImageMetadata>(
	"../**/*.{png,jpg,jpeg,webp,avif}",
	{ import: "default" },
);

async function resolveArticleImage(entry: PostEntry) {
	const processedImage = processCoverImageSync(entry.data.image, entry.id);
	const imageApiUrls = getApiUrlList(entry.data.image, entry.id);

	if (!processedImage) {
		return { imageUrl: "", imageApiUrls, imageReferrerPolicy: "" };
	}

	const isLocal = !(
		processedImage.startsWith("/") ||
		processedImage.startsWith("http") ||
		processedImage.startsWith("https") ||
		processedImage.startsWith("data:")
	);

	if (isLocal) {
		const basePath = getFileDirFromPath((entry as any).filePath || "");
		const normalizedPath = path
			.normalize(path.join("../", basePath, processedImage))
			.replace(/\\/g, "/");
		const imageFile = articleImageFiles[normalizedPath];

		if (!imageFile) {
			return { imageUrl: "", imageApiUrls, imageReferrerPolicy: "" };
		}

		const image = await imageFile();
		return { imageUrl: image.src, imageApiUrls, imageReferrerPolicy: "" };
	}

	const imageUrl = processedImage.startsWith("/")
		? url(processedImage)
		: processedImage;

	return {
		imageUrl,
		imageApiUrls,
		imageReferrerPolicy: shouldAddNoReferrer(imageUrl) ? "no-referrer" : "",
	};
}

const articleListPosts = await Promise.all(
	posts.map(async (entry) => {
		const { remarkPluginFrontmatter } = await render(entry);
		const articleImage = await resolveArticleImage(entry);
		const rawCategory = entry.data.category?.trim();
		const category = rawCategory || i18n(I18nKey.uncategorized);
		const tagList = (entry.data.tags || [])
			.map((tag: string) => tag.trim())
			.filter(Boolean)
			.map((tag: string) => ({ name: tag, url: getTagUrl(tag) }));

		return {
			id: entry.id,
			title: entry.data.title,
			url: getPostUrlBySlug(entry.id),
			publishedIso: entry.data.published.toISOString(),
			publishedText: dateFormatter.format(entry.data.published),
			category,
			categoryUrl: getCategoryUrl(rawCategory || null),
			tags: tagList,
			description:
				entry.data.description ||
				remarkPluginFrontmatter?.excerpt ||
				"暂无文章简介，点击卡片查看完整内容。",
			imageUrl: articleImage.imageUrl,
			imageApiUrls: articleImage.imageApiUrls,
			imageReferrerPolicy: articleImage.imageReferrerPolicy,
			pinned: !!entry.data.pinned,
			password: !!(entry.data as any).password,
		};
	}),
);

const defaultLayout = siteConfig.postListLayout.defaultMode || "list";
const allowLayoutSwitch = siteConfig.postListLayout.allowSwitch;
---

<MainGridLayout title={`${decodedCategory} - ${i18n(I18nKey.categories)}`}>
	<!-- 页面页头：面包屑 + 标题 + 文章总数 -->
	<PageHeader
		title={decodedCategory}
		eyebrow={i18n(I18nKey.categories)}
		variant="stacked"
		breadcrumbs={[
			{ name: i18n(I18nKey.categories), href: getCategoryPageUrl(), icon: "material-symbols:folder-open" },
			{ name: decodedCategory, icon: "material-symbols:label" },
		]}
	>
		<p class="text-sm text-neutral-500 dark:text-neutral-400">
			{totalPosts} {i18n(I18nKey.postsCount)}
		</p>
	</PageHeader>

	<!-- 标签筛选区域 -->
	{
		tags.length > 0 && (
			<div class="card-base px-6 py-5 mb-6">
				<div class="flex items-center gap-3 mb-3">
					<Icon name="material-symbols:label" class="text-lg text-(--primary)" />
					<span class="text-sm font-medium text-90">{i18n(I18nKey.tags)}</span>
					<span class="text-xs text-30">({tags.length})</span>
				</div>
				<div class="flex flex-wrap gap-2">
					{tags.map((tag: { name: string; count: number }) => (
						<a
							href={getTagUrl(tag.name)}
							class="btn-regular px-3 py-1.5 text-sm rounded-md
								   transition-all duration-200
								   hover:scale-105 hover:bg-(--primary)/20
								   active:scale-95"
						>
							#{tag.name}
							<span class="ml-1 text-xs opacity-60">({tag.count})</span>
						</a>
					))}
				</div>
			</div>
		)
	}

	<section class="article-list-page">
		<header class="article-list-page__header">
			<div class="article-list-page__header-left">
				<div class="article-list-page__controls">
					<div class:list={["article-list-page__tabs", { "is-hidden": !allowLayoutSwitch }]}>
						<AnimatedTabs client:load activeTab={defaultLayout === "grid" ? "grid" : "list"} />
					</div>
					<div class="article-list-page__total" aria-label={`共 ${articleListPosts.length} 篇文章`}>
						<span class="article-list-page__total-number">{articleListPosts.length}</span>
						<span class="article-list-page__total-label">篇文章</span>
					</div>
				</div>
			</div>
		</header>

		<ArticleVirtualList
			client:load
			posts={articleListPosts}
			defaultView={defaultLayout === "grid" ? "grid" : "list"}
			postsPerPage={siteConfig.pagination.postsPerPage}
		/>
	</section>
</MainGridLayout>
