---
import { sakuraConfig } from "@/config";

const config = sakuraConfig;
---

{sakuraConfig?.enable && (
  <script is:inline define:vars={{ sakuraConfig: config }}>
    (function () {
      // 单例保护：已初始化则跳过
      if (window.__fireflySakuraInited) return;
      window.__fireflySakuraInited = true;

      var FLAKE = '🪰';
      // 与设置面板（setting-utils.ts）共用的持久化键
      var STORAGE_KEY = 'sakuraEnabled';
      // emoji 基础字号（px），实际大小 = BASE_SIZE × size 倍数
      var BASE_SIZE = 15;

      var C = sakuraConfig || {};
      var NUM = C.sakuraNum || 21;
      var SZ_MIN = (C.size && C.size.min) || 0.5;
      var SZ_MAX = (C.size && C.size.max) || 1.1;
      var V_MIN = (C.speed && C.speed.vertical && C.speed.vertical.min) || 1.5;
      var V_MAX = (C.speed && C.speed.vertical && C.speed.vertical.max) || 2.2;
      var H_MIN = (C.speed && C.speed.horizontal && C.speed.horizontal.min) || -1.7;
      var H_MAX = (C.speed && C.speed.horizontal && C.speed.horizontal.max) || -1.2;
      var A_MIN = (C.opacity && C.opacity.min) || 0.3;
      var A_MAX = (C.opacity && C.opacity.max) || 0.9;
      var Z_INDEX = C.zIndex || 100;

      var S = window.__fireflySakura = window.__fireflySakura || {
        canvas: null, ctx: null, flakeList: null,
        animationId: null, frameCount: 0, enabled: true,
        resizeHandler: null
      };

      // 恢复持久化的开关状态（未设置时默认开启，与 sakuraConfig.enable 一致）
      var saved = localStorage.getItem(STORAGE_KEY);
      S.enabled = saved === null ? true : saved === 'true';

      class Flake {
        constructor(w, h, mode) {
          this.w = w;
          this.h = h;
          this.spawn(mode);
        }
        // mode: 'top' 从屏幕上方外侧进入，'right' 从右侧进入，'scatter' 散布在屏幕内
        spawn(mode) {
          this.size = BASE_SIZE * (SZ_MIN + Math.random() * (SZ_MAX - SZ_MIN));
          this.alpha = A_MIN + Math.random() * (A_MAX - A_MIN);
          this.fallSpeed = V_MIN + Math.random() * (V_MAX - V_MIN);
          this.drift = H_MIN + Math.random() * (H_MAX - H_MIN);
          if (mode === 'top') {
            this.x = Math.random() * this.w;
            this.y = -this.size * 2 - Math.random() * this.h * 0.5;
          } else if (mode === 'right') {
            this.x = this.w + this.size;
            this.y = Math.random() * this.h;
          } else {
            this.x = Math.random() * this.w;
            this.y = Math.random() * this.h;
          }
        }
        update() {
          this.y += this.fallSpeed;
          this.x += this.drift;
          if (this.y > this.h + this.size || this.x > this.w + this.size || this.x < -this.size) {
            this.spawn(Math.random() < 0.6 ? 'top' : 'right');
          }
        }
        draw(ctx) {
          ctx.globalAlpha = this.alpha;
          ctx.font = this.size + 'px serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(FLAKE, this.x, this.y);
        }
      }

      class FlakeList {
        constructor() { this.list = []; }
        push(f) { this.list.push(f); }
        update() { for (var i = 0; i < this.list.length; i++) this.list[i].update(); }
        draw(ctx) { for (var i = 0; i < this.list.length; i++) this.list[i].draw(ctx); }
      }

      function createCanvas() {
        if (S.canvas && S.canvas.parentNode) return; // 已存在且挂载
        S.canvas = document.createElement('canvas');
        S.canvas.id = 'canvas_sakura';
        S.canvas.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:' + Z_INDEX;
        document.body.appendChild(S.canvas);
        S.ctx = S.canvas.getContext('2d', { alpha: true });
        S.canvas.width = window.innerWidth;
        S.canvas.height = window.innerHeight;
      }

      function createFlakes() {
        S.flakeList = new FlakeList();
        var w = S.canvas ? S.canvas.width : window.innerWidth;
        var h = S.canvas ? S.canvas.height : window.innerHeight;
        var half = Math.ceil(NUM / 2);
        for (var i = 0; i < NUM; i++) {
          // 初始一半从上方进入，一半散布在屏幕内，避免开场空白
          S.flakeList.push(new Flake(w, h, i < half ? 'top' : 'scatter'));
        }
      }

      function animate() {
        if (!S.enabled || !S.ctx || !S.canvas || !S.flakeList) return;
        // 检查 canvas 是否仍在 DOM 中（Swup 可能移除了它）
        if (!S.canvas.parentNode) {
          document.body.appendChild(S.canvas);
        }
        S.frameCount = (S.frameCount + 1) % 3;
        if (S.frameCount === 0) {
          S.ctx.clearRect(0, 0, S.canvas.width, S.canvas.height);
          S.flakeList.update();
          S.flakeList.draw(S.ctx);
        }
        S.animationId = requestAnimationFrame(animate);
      }

      function start() {
        if (S.canvas && S.canvas.parentNode) return;
        createCanvas();
        createFlakes();
        animate();
      }

      function stop() {
        if (S.animationId) { cancelAnimationFrame(S.animationId); S.animationId = null; }
        if (S.canvas && S.canvas.parentNode) { S.canvas.parentNode.removeChild(S.canvas); }
        S.canvas = null; S.ctx = null; S.flakeList = null;
      }

      // 设置指定状态并持久化（设置面板通过 setting-utils.setSakuraEnabled 调用）
      window.setSakuraEnabled = function (v) {
        v = !!v;
        if (S.enabled === v) return;
        S.enabled = v;
        localStorage.setItem(STORAGE_KEY, v ? 'true' : 'false');
        if (v) { start(); }
        else { stop(); }
        return v;
      };
      // 兼容旧接口
      window.toggleSakura = function () {
        window.setSakuraEnabled(!S.enabled);
        return S.enabled;
      };
      window.getSakuraEnabled = function () { return S.enabled; };

      if (!S.resizeHandler) {
        S.resizeHandler = function () {
          if (S.canvas) {
            S.canvas.width = window.innerWidth;
            S.canvas.height = window.innerHeight;
            // 同步更新粒子的越界判定范围
            if (S.flakeList) {
              for (var i = 0; i < S.flakeList.list.length; i++) {
                S.flakeList.list[i].w = S.canvas.width;
                S.flakeList.list[i].h = S.canvas.height;
              }
            }
          }
        };
        window.addEventListener('resize', S.resizeHandler);
      }

      // 延迟初始化
      setTimeout(function () {
        if (S.enabled) start();
      }, 300);
    })();
  </script>
)}
