<div
	id="page-loader"
	class="page-loader page-loader--hidden"
	role="status"
	aria-live="polite"
	aria-label="Page loading"
>
	<div
		aria-label="Running animation"
		role="img"
		class="page-loader__animation"
	>
		<div class="cat">
			<div class="body"></div>
			<div class="head">
				<div class="face"></div>
			</div>
			<div class="foot">
				<div class="tummy-end"></div>
				<div class="bottom"></div>
				<div class="legs left"></div>
				<div class="legs right"></div>
			</div>
			<div class="paw">
				<div class="hands left"></div>
				<div class="hands right"></div>
			</div>
		</div>
	</div>
	<span class="page-loader__sr-only">Loading</span>
</div>
