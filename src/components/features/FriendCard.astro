---
export interface Props {
	title: string;
	href: string;
	imgurl: string;
	desc: string;
	tags?: string[];
	siteshot?: string;
}

const { title, href, imgurl, desc, tags = [], siteshot = "" } = Astro.props;

// 从 href 提取 host（去掉 www. 前缀）
const host = (() => {
	try {
		return new URL(href).host.replace(/^www\./, "");
	} catch {
		return href;
	}
})();

// 头像加载失败时的降级文字（取 title 前 2 个字符）
const avatarFallback = title.slice(0, 2);

const typeColors: Record<string, { bg: string; text: string }> = {
	Blog: { bg: "rgba(59, 130, 246, 0.92)", text: "#ffffff" },
	Docs: { bg: "rgba(245, 158, 11, 0.92)", text: "#ffffff" },
};

const primaryTag = tags[0] || "Blog";
const typeColor = typeColors[primaryTag] || typeColors.Blog;
---

<a
  class="friend-card-link"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  title={`${title} - ${desc}`}
  data-desc={desc}
  data-host={host}
  data-siteshot={siteshot}
  style={siteshot ? `--siteshot-url: url("${siteshot}");` : ""}
>
  <!-- 顶部：友链主页截图 + 类型角标 + 状态徽章 -->
  <div class="friend-card-screenshot">
    <span
      class="friend-card-type-badge"
      style={`background-color: ${typeColor.bg}; color: ${typeColor.text};`}
    >
      {primaryTag}
    </span>
    <!-- 友链可达性状态徽章（由 Layout.astro 的 renderLinkStatus() 渲染颜色和文字） -->
    <span class="friend-status" data-status=""></span>
  </div>

  <!-- 底部：圆形头像 + 姓名 + 域名 + 描述 -->
  <div class="friend-card-info">
    <div class="friend-card-avatar-wrap" data-fallback={avatarFallback}>
      <img
        src={imgurl}
        alt={title}
        class="friend-card-avatar"
        loading="lazy"
        decoding="async"
        onerror="this.classList.add('is-error');this.parentElement?.classList.add('is-error');"
      />
    </div>
    <div class="friend-card-text">
      <h3 class="friend-card-title">{title}</h3>
      <p class="friend-card-domain">{host}</p>
      <p class="friend-card-desc">{desc}</p>
    </div>
  </div>
</a>

<style>
  .friend-card-link {
    display: flex;
    flex-direction: column;
    position: relative;
    background: var(--card-bg, #fff);
    border: 1px solid var(--card-border, oklch(85% 0 0 / 0.92));
    border-radius: var(--radius-card, 16px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 8px 24px -12px rgba(15, 23, 42, 0.12);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      border-color 300ms ease,
      box-shadow 350ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 350ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  :root.dark .friend-card-link {
    background: var(--card-bg, #1c1d20);
    border-color: var(--card-border, rgba(255, 255, 255, 0.10));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 1px 2px rgba(0, 0, 0, 0.3),
      0 8px 24px -12px rgba(0, 0, 0, 0.5);
  }

  .friend-card-link:hover {
    border-color: var(--card-border-hover, rgba(15, 23, 42, 0.16));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      0 2px 4px rgba(0, 0, 0, 0.06),
      0 16px 32px -16px rgba(15, 23, 42, 0.18);
    transform: translateY(-2px);
  }

  :root.dark .friend-card-link:hover {
    border-color: var(--card-border-hover, rgba(255, 255, 255, 0.20));
  }

  /* 顶部：友链主页截图区（16:10） */
  .friend-card-screenshot {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: oklch(0.92 0 0);
    background-image: var(--siteshot-url, none);
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  :root.dark .friend-card-screenshot {
    background-color: oklch(0.20 0 0);
  }

  /* 截图加载失败时降级：渐变占位（由 JS 切换 .is-fallback） */
  .friend-card-screenshot.is-fallback {
    background-image:
      radial-gradient(circle at 20% 30%, rgba(91, 141, 239, 0.20), transparent 60%),
      radial-gradient(circle at 80% 70%, rgba(245, 158, 11, 0.18), transparent 60%);
  }

  /* 截图底部渐变（让信息区视觉过渡更柔和） */
  .friend-card-screenshot::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.05) 50%,
      rgba(0, 0, 0, 0.20) 100%
    );
    pointer-events: none;
  }

  /* 左上角类型角标 */
  .friend-card-type-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.2rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: 6px;
    z-index: 3;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  /* 右上角状态徽章：白点 + 延迟数字（4 色由 data-status 切换） */
  .friend-status {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: none; /* 默认隐藏，由 JS 根据 result.json 数据显示 */
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem 0.25rem 0.45rem;
    font-size: 0.6875rem;
    font-weight: 600;
    color: #fff;
    border-radius: 9999px;
    z-index: 4;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background-color: rgba(34, 197, 94, 0.92);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .friend-status[data-status="success"] { background-color: rgba(34, 197, 94, 0.92); }
  .friend-status[data-status="slow"]    { background-color: rgba(245, 158, 11, 0.92); }
  .friend-status[data-status="warn"]    { background-color: rgba(249, 115, 22, 0.92); }
  .friend-status[data-status="timeout"] { background-color: rgba(239, 68, 68, 0.92); }

  /* 状态徽章白点（脉冲动画） */
  .friend-status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.6);
    animation: status-pulse 2.4s ease-out infinite;
    flex-shrink: 0;
  }

  @keyframes status-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.6); }
    70%  { box-shadow: 0 0 0 6px rgba(255, 255, 255, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-status::before { animation: none; }
  }

  /* 底部信息区 */
  .friend-card-info {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.875rem;
    position: relative;
  }

  /* 圆形头像（压边效果） */
  .friend-card-avatar-wrap {
    position: relative;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    margin-top: -1.75rem;        /* 头像上半部压在截图与信息区交界 */
    margin-left: 0.125rem;
    z-index: 2;
  }

  .friend-card-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: oklch(0.85 0 0);
    border: 2px solid var(--card-bg, #fff);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    display: block;
  }

  :root.dark .friend-card-avatar {
    background: oklch(0.30 0 0);
    border-color: var(--card-bg, #1c1d20);
  }

  /* 头像加载失败：显示 fallback 文字（前 2 字符） */
  .friend-card-avatar.is-error {
    display: none;
  }
  .friend-card-avatar-wrap.is-error::after {
    content: attr(data-fallback);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: oklch(0.45 0 0);
    background: oklch(0.88 0 0);
    border-radius: 50%;
    border: 2px solid var(--card-bg, #fff);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }
  :root.dark .friend-card-avatar-wrap.is-error::after {
    color: oklch(0.65 0 0);
    background: oklch(0.28 0 0);
    border-color: var(--card-bg, #1c1d20);
  }

  /* 文字区 */
  .friend-card-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .friend-card-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: oklch(0.15 0 0);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :root.dark .friend-card-title {
    color: oklch(0.95 0 0);
  }

  .friend-card-domain {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 400;
    color: oklch(0.5 0 0);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :root.dark .friend-card-domain {
    color: oklch(0.6 0 0);
  }

  .friend-card-desc {
    margin: 0.25rem 0 0 0;
    font-size: 0.8125rem;
    font-weight: 400;
    color: oklch(0.4 0 0);
    line-height: 1.5;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :root.dark .friend-card-desc {
    color: oklch(0.7 0 0);
  }

  /* 移动端适配 */
  @media (max-width: 640px) {
    .friend-card-screenshot {
      aspect-ratio: 16 / 9;
    }
  }
</style>
