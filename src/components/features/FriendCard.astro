---
export interface Props {
	title: string;
	href: string;
	imgurl: string;
	desc: string;
	tags?: string[];
	siteshot?: string;
}

import { dicebearUrl, inlineSvgAvatar } from "@/utils/avatar-fallback";

const { title, href, imgurl, desc, tags = [], siteshot = "" } = Astro.props;

// 从 href 提取 host（去掉 www. 前缀）
const host = (() => {
	try {
		return new URL(href).host.replace(/^www\./, "");
	} catch {
		return href;
	}
})();

// 三级头像容错链 SSR 初始值：主头像 → dicebear → 内联 SVG（用于 data-avatar-fallback）
const fallbackDicebear = dicebearUrl(title);
const fallbackInline = inlineSvgAvatar(title);
---

<a
  class="friend-card-link"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  title={`${title} - ${desc}`}
  data-desc={desc}
  data-host={host}
  data-siteshot={siteshot}
  data-avatar-fallback-dicebear={fallbackDicebear}
  data-avatar-fallback-inline={fallbackInline}
  style={siteshot ? `--siteshot-url: url("${siteshot}");` : ""}
>
  <!-- 顶部：友链主页截图 + 状态徽章（去除 Blog 角标） -->
  <div class="friend-card-screenshot">
    <!-- 友链可达性状态徽章（由 Layout.astro 的 renderLinkStatus() 渲染颜色和文字） -->
    <span class="friend-status" data-status=""></span>
  </div>

  <!-- 中部：圆形头像 + 姓名 + 描述（压缩版） -->
  <div class="friend-card-info">
    <div class="friend-card-avatar-wrap" data-fallback={title.slice(0, 2)}>
      <img
        src={imgurl}
        alt={title}
        class="friend-card-avatar"
        loading="lazy"
        decoding="async"
        data-fb-1={fallbackDicebear}
        data-fb-2={fallbackInline}
        onerror="var d=this.dataset;if(d.fb1Used!=='1'){d.fb1Used='1';this.onerror=function(){this.classList.add('is-error');this.parentElement?.classList.add('is-error');};this.src=d.fb1;}else{this.classList.add('is-error');this.parentElement?.classList.add('is-error');}"
      />
    </div>
    <div class="friend-card-text">
      <h3 class="friend-card-title">{title}</h3>
      <p class="friend-card-desc">{desc}</p>
    </div>
  </div>
</a>

<style>
  .friend-card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    /* 容器本身无边框/背景，由 3 段拼出卡片框 */
    transition:
      transform 350ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .friend-card-link:hover {
    transform: translateY(-2px);
  }

  /* ===== 顶部：友链主页截图区（16:10） ===== */
  .friend-card-screenshot {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: oklch(0.92 0 0);
    background-image: var(--siteshot-url, none);
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    overflow: hidden;
    border: 1px solid var(--card-border, oklch(85% 0 0 / 0.92));
    border-bottom: none;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    transition: border-color 300ms ease;
  }

  :root.dark .friend-card-screenshot {
    background-color: oklch(0.20 0 0);
    border-color: var(--card-border, rgba(255, 255, 255, 0.10));
  }

  .friend-card-screenshot.is-fallback {
    background-image:
      radial-gradient(circle at 20% 30%, rgba(91, 141, 239, 0.20), transparent 60%),
      radial-gradient(circle at 80% 70%, rgba(245, 158, 11, 0.18), transparent 60%);
  }

  /* 截图底部渐变（让信息区视觉过渡更柔和） */
  .friend-card-screenshot::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.05) 50%,
      rgba(0, 0, 0, 0.20) 100%
    );
    pointer-events: none;
  }

  /* 右上角状态徽章：白点 + 延迟数字（4 色由 data-status 切换） */
  .friend-status {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: none;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem 0.25rem 0.45rem;
    font-size: 0.6875rem;
    font-weight: 600;
    color: #fff;
    border-radius: 9999px;
    z-index: 4;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background-color: rgba(34, 197, 94, 0.92);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .friend-status[data-status="success"] { background-color: rgba(34, 197, 94, 0.92); }
  .friend-status[data-status="slow"]    { background-color: rgba(245, 158, 11, 0.92); }
  .friend-status[data-status="warn"]    { background-color: rgba(249, 115, 22, 0.92); }
  .friend-status[data-status="timeout"] { background-color: rgba(239, 68, 68, 0.92); }

  .friend-status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.6);
    animation: status-pulse 2.4s ease-out infinite;
    flex-shrink: 0;
  }

  @keyframes status-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.6); }
    70%  { box-shadow: 0 0 0 6px rgba(255, 255, 255, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-status::before { animation: none; }
  }

  /* ===== 中部：信息区（压缩版，卡片底部） ===== */
  .friend-card-info {
    display: flex;
    gap: 0.625rem;                          /* 头像与文字间距压缩 */
    align-items: flex-start;
    padding: 0.625rem 0.75rem 0.625rem 0.75rem;   /* 内边距压缩 */
    background: var(--card-bg, #fff);
    border-left: 1px solid var(--card-border, oklch(85% 0 0 / 0.92));
    border-right: 1px solid var(--card-border, oklch(85% 0 0 / 0.92));
    border-bottom: 1px solid var(--card-border, oklch(85% 0 0 / 0.92));
    border-bottom-left-radius: 16px;         /* 卡片底部圆角 */
    border-bottom-right-radius: 16px;
    min-height: 3.75rem;                    /* 强制最小高度，让所有卡片等高 */
    transition: border-color 300ms ease;
  }

  :root.dark .friend-card-info {
    background: var(--card-bg, #1c1d20);
    border-left-color: var(--card-border, rgba(255, 255, 255, 0.10));
    border-right-color: var(--card-border, rgba(255, 255, 255, 0.10));
    border-bottom-color: var(--card-border, rgba(255, 255, 255, 0.10));
  }

  /* 圆形头像（缩小） */
  .friend-card-avatar-wrap {
    position: relative;
    flex-shrink: 0;
    width: 2.5rem;                          /* 头像缩小 3rem → 2.5rem */
    height: 2.5rem;
    margin-top: -1.25rem;                   /* 上移幅度对应调整 */
    margin-left: 0.0625rem;
    z-index: 2;
  }

  .friend-card-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: oklch(0.85 0 0);
    border: 2px solid var(--card-bg, #fff);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    display: block;
  }

  :root.dark .friend-card-avatar {
    background: oklch(0.30 0 0);
    border-color: var(--card-bg, #1c1d20);
  }

  .friend-card-avatar.is-error { display: none; }

  .friend-card-avatar-wrap.is-error::after {
    content: attr(data-fallback);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: 600;
    color: oklch(0.45 0 0);
    background: oklch(0.88 0 0);
    border-radius: 50%;
    border: 2px solid var(--card-bg, #fff);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }
  :root.dark .friend-card-avatar-wrap.is-error::after {
    color: oklch(0.65 0 0);
    background: oklch(0.28 0 0);
    border-color: var(--card-bg, #1c1d20);
  }

  /* 文字区 */
  .friend-card-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .friend-card-title {
    margin: 0;
    font-size: 0.875rem;                    /* 缩小 0.9375rem → 0.875rem */
    font-weight: 600;
    color: oklch(0.15 0 0);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :root.dark .friend-card-title { color: oklch(0.95 0 0); }

  .friend-card-desc {
    margin: 0.125rem 0 0 0;
    font-size: 0.75rem;                     /* 缩小 0.8125rem → 0.75rem */
    font-weight: 400;
    color: oklch(0.4 0 0);
    line-height: 1.45;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* 关键修复：强制 2 行最小高度，1 行描述也占 2 行空间，所有卡片等高 */
    min-height: calc(0.75rem * 1.45 * 2);
  }

  :root.dark .friend-card-desc { color: oklch(0.7 0 0); }

  /* hover 时 2 段同步加深边框 */
  .friend-card-link:hover .friend-card-screenshot,
  .friend-card-link:hover .friend-card-info {
    border-color: var(--card-border-hover, rgba(15, 23, 42, 0.16));
  }
  :root.dark .friend-card-link:hover .friend-card-screenshot,
  :root.dark .friend-card-link:hover .friend-card-info {
    border-color: var(--card-border-hover, rgba(255, 255, 255, 0.20));
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    /* 隐藏背景截图：去除图样式 */
    .friend-card-screenshot {
      display: none;
    }

    /* 压缩信息区：无截图后整张卡片只剩这一段 */
    .friend-card-info {
      padding: 0.4rem 0.5rem 0.5rem;
      gap: 0.4rem;
      min-height: 0;
      border: 1px solid var(--card-border, oklch(85% 0 0 / 0.92));
      border-radius: 12px;
      align-items: center;
    }

    /* 头像进一步缩小 */
    .friend-card-avatar-wrap {
      width: 1.75rem;
      height: 1.75rem;
      margin-top: 0;
      margin-left: 0;
    }

    .friend-card-avatar {
      border-width: 1.5px;
    }

    .friend-card-avatar-wrap.is-error::after {
      border-width: 1.5px;
    }

    /* 标题 / 描述压缩 */
    .friend-card-text {
      gap: 0.05rem;
    }

    .friend-card-title {
      font-size: 0.75rem;
      line-height: 1.2;
    }

    .friend-card-desc {
      font-size: 0.65rem;
      line-height: 1.35;
      margin-top: 0.05rem;
      -webkit-line-clamp: 1;
      line-clamp: 1;
      min-height: 0;
    }

    /* 隐藏状态徽章（移动端空间有限） */
    .friend-status {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-card-link { transition-duration: 0.01ms; }
  }
</style>
