---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
---

<dynamic-inline-comments class="dynamic-inline-comments">
	<button type="button" class="dynamic-comment-toggle" data-comment-toggle>
		<Icon is:inline name="material-symbols:chat-bubble-outline-rounded" />
		<span>{i18n(I18nKey.comments)}</span>
	</button>
</dynamic-inline-comments>
