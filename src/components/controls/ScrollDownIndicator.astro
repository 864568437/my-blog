---
import { Icon } from "astro-icon/components";
---

<div
  id="scroll-down-indicator"
  class="scroll-down-indicator"
  onclick="document.getElementById('main-grid')?.scrollIntoView({ behavior: 'smooth' })"
>
  <Icon is:inline name="material-symbols:keyboard-arrow-down-rounded" class="scroll-down-icon" />
</div>

<script>
  function updateScrollDownVisibility() {
    const indicator = document.getElementById("scroll-down-indicator");
    if (!indicator) return;
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    if (scrollTop > 100) {
      indicator.classList.add("hide");
    } else {
      indicator.classList.remove("hide");
    }
  }

  // 初次加载 + 每次 Swup 页面切换后重新绑定滚动监听
  function initScrollDownIndicator() {
    window.removeEventListener("scroll", updateScrollDownVisibility);
    window.addEventListener("scroll", updateScrollDownVisibility, { passive: true });
    updateScrollDownVisibility();
  }

  initScrollDownIndicator();
  document.addEventListener("astro:page-load", initScrollDownIndicator);
</script>
