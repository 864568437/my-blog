---
import { siteConfig } from "@/config";
/**
 * TimelineGraph.astro —— 更新日志「图形化」视图
 * 参考 my-blog 关于页 ChangelogGraph：蛇形网格卡片 + 行间回环箭头 + 悬停 SVG 虚线关联 + 详情弹窗。
 * 数据源与时间线同源（git log 自动派生），仅展示最近 N 条。
 * 因默认 hidden，需由页面在首次显示时派发 `timeline:show-graph` 触发初始化/重排。
 */
import { commitType, type GitCommit } from "@/utils/git-log";

interface Props {
	commits: GitCommit[];
}

const { commits } = Astro.props;
const REPO_URL = siteConfig.repoUrl ?? "";
const LIMIT = 30;
const total = commits.length;
const visible = commits.slice(0, LIMIT);
const hiddenCount = total - visible.length;

// git 提交类型 → 参考五色；docs 并入 chore；其余回退 primary
const TYPE_LABELS: Record<string, string> = {
	feat: "功能",
	fix: "修复",
	style: "样式",
	refactor: "重构",
	chore: "维护",
	docs: "文档",
	other: "其他",
};

function normalizeType(raw: string): string {
	if (TYPE_LABELS[raw]) return raw;
	if (raw === "docs") return "chore";
	return "other";
}

/**
 * 提交类型识别（对齐参考图的多彩类型色点）：
 * 1) Conventional Commits 前缀；2) 无前缀时按中文关键词归类。
 */
function classifyCommit(subject: string): string {
	const cc = commitType(subject);
	if (cc !== "other") return normalizeType(cc);
	if (/修复|修正|bug|问题|错误/.test(subject)) return "fix";
	if (/重构|清理|移除|优化|升级|整理/.test(subject)) return "refactor";
	if (/文档|教程|说明/.test(subject)) return "docs";
	if (/更新|新增|添加|发布|初始|支持|功能/.test(subject)) return "feat";
	return "other";
}

/**
 * 把改动文件映射成「模块」集合（对应 my-blog 的页面标签）：
 *   src/config/friendsConfig.ts      → "src/config"（配置）
 *   src/components/features/X.astro  → "src/components"（组件）
 *   src/pages/friends.astro          → "src/pages"（页面）
 *   public/favicon.svg               → "public"（资源）
 * 提取 src 下二级目录；根目录文件计入 "root"。
 */
function moduleOf(file: string): string {
	const parts = file.split("/").filter(Boolean);
	if (parts.length <= 1) return "root";
	// 带引号（git 对含空格/中文路径会加引号）
	const first = parts[0].replace(/^"|"$/g, "");
	if (first === "src" && parts.length >= 2) {
		return "src/" + parts[1].replace(/^"|"$/g, "");
	}
	return first;
}

const MODULE_LABELS: Record<string, string> = {
	"src/pages": "页面",
	"src/components": "组件",
	"src/styles": "样式",
	"src/layouts": "布局",
	"src/config": "配置",
	"src/utils": "工具",
	"src/constants": "常量",
	"src/content": "内容",
	"src/types": "类型",
	"src/i18n": "国际化",
	"src/scripts": "脚本",
	public: "资源",
	scripts: "脚本",
	root: "根目录",
	".github": "CI",
	".trae": "工具链",
	"src/pages/api": "API",
};

function labelOfModule(mod: string): string {
	return MODULE_LABELS[mod] ?? mod;
}

// 关联邻接表：两提交共享至少 1 个文件即互相关联（对齐参考图"共享页面"逻辑）
interface GraphLink {
	target: number;
	sharedFiles: string[];
	modules: string[];
}

const MAX_LINKS = 3;
const MIN_SHARED = 1;
const linksMap = new Map<number, GraphLink[]>();
for (let i = 0; i < visible.length; i++) {
	for (let j = i + 1; j < visible.length; j++) {
		const sharedFiles = visible[i].files.filter((f) =>
			visible[j].files.includes(f),
		);
		if (sharedFiles.length < MIN_SHARED) continue;
		const modules = [...new Set(sharedFiles.map(moduleOf))];
		if (!linksMap.has(i)) linksMap.set(i, []);
		if (!linksMap.has(j)) linksMap.set(j, []);
		linksMap.get(i)?.push({ target: j, sharedFiles, modules });
		linksMap.get(j)?.push({ target: i, sharedFiles, modules });
	}
}
// 每张卡仅保留 3 个最强关联（按共享文件数降序），避免扇形发散
for (const [, list] of linksMap) {
	list.sort((a, b) => b.sharedFiles.length - a.sharedFiles.length);
	list.length = Math.min(list.length, MAX_LINKS);
}

// 关联标签：按"模块"归并，输出"模块1、模块2"形式的胶囊文字
function summarizeModules(modules: string[]): string {
	const labels = modules.map(labelOfModule);
	if (labels.length <= 2) return labels.join("、");
	return `${labels[0]}、${labels[1]} 等 ${labels.length} 个模块`;
}
---

<div class="tl-graph" data-tl-graph data-repo-url={REPO_URL}>
	{hiddenCount > 0 && (
		<div class="tl-graph__notice">
			图形视图展示最近 {LIMIT} 条，完整 {total} 条记录见「时间线」视图
		</div>
	)}

	<svg class="tl-graph__wires" data-tl-graph-wires aria-hidden="true">
		<defs>
			<marker
				id="tl-graph-arrow"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6.5"
				markerHeight="6.5"
				orient="auto-start-reverse"
			>
				<path
					d="M2 1L8 5L2 9"
					fill="none"
					stroke="context-stroke"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</marker>
		</defs>
	</svg>

	<ol class="tl-graph__grid" data-tl-graph-grid>
		{
			visible.map((c, i) => {
				const num = total - i;
				const type = classifyCommit(c.subject);
				const links = linksMap.get(i) ?? [];
				const summary =
					c.body.split(/\n/)[0].trim() || c.subject;
				return (
					<li
						class="tl-graph-card"
						data-tl-graph-card
						data-index={i}
						data-num={num}
						data-type={type}
						data-hash={c.hash}
						data-links={JSON.stringify(
							links.map((l) => ({ t: l.target, f: summarizeModules(l.modules) })),
						)}
					>
						<button
							type="button"
							class="tl-graph-card__inner"
							data-tl-graph-open
							aria-haspopup="dialog"
						>
							<span class="tl-graph-card__num" aria-hidden="true">
								{String(num).padStart(2, "0")}
							</span>
							<span class="tl-graph-card__meta">
								<span class="tl-graph-card__type">{TYPE_LABELS[type] ?? type}</span>
								<time class="tl-graph-card__date" datetime={c.date}>
									{c.date}
								</time>
							</span>
							<span class="tl-graph-card__title">{c.subject}</span>
							<span class="tl-graph-card__summary">{summary}</span>
						</button>
						<div class="tl-graph-card__detail" hidden>
							<div class="tl-graph-card__detail-body">
								{c.body
									.split(/\n{2,}/)
									.map((para) => para.trim())
									.filter(Boolean)
									.map((para) => (
										<p class="tl-graph-card__detail-text">{para}</p>
									))}
							</div>
						</div>
					</li>
				);
			})
		}
	</ol>

	<div class="tl-graph-dialog" data-tl-graph-dialog hidden>
		<div class="tl-graph-dialog__overlay" data-tl-graph-close></div>
		<div
			class="tl-graph-dialog__panel"
			role="dialog"
			aria-modal="true"
			aria-label="更新详情"
		>
			<button
				type="button"
				class="tl-graph-dialog__close"
				data-tl-graph-close
				aria-label="关闭"
			>
				&times;
			</button>
			<div class="tl-graph-dialog__meta">
				<span class="tl-graph-dialog__num" data-dlg-num></span>
				<span class="tl-graph-dialog__type" data-dlg-type></span>
				<time class="tl-graph-dialog__date" data-dlg-date></time>
			</div>
			<h3 class="tl-graph-dialog__title" data-dlg-title></h3>
			<div class="tl-graph-dialog__detail" data-dlg-detail></div>
			<div class="tl-graph-dialog__section">
				<span class="tl-graph-dialog__label">提交</span>
				<a class="tl-graph-dialog__hash" data-dlg-hash target="_blank" rel="noopener noreferrer"></a>
			</div>
			<div class="tl-graph-dialog__section" data-dlg-related-section>
				<span class="tl-graph-dialog__label">相关更新</span>
				<ul class="tl-graph-dialog__related" data-dlg-related></ul>
			</div>
		</div>
	</div>
</div>

<script>
	function initTimelineGraph() {
		const rootEl = document.querySelector<HTMLElement>("[data-tl-graph]");
		if (!rootEl) return;
		const root: HTMLElement = rootEl;
		(root as any).__cleanup?.();

		const ac = new AbortController();
		const { signal } = ac;
		(root as any).__cleanup = () => ac.abort();

		const NS = "http://www.w3.org/2000/svg";
		const grid = root.querySelector<HTMLElement>("[data-tl-graph-grid]")!;
		const wiresSvg = root.querySelector<SVGSVGElement>("[data-tl-graph-wires]")!;
		const dialog = root.querySelector<HTMLElement>("[data-tl-graph-dialog]")!;

		let activeCard: HTMLElement | null = null;
		const wireAnims = new Set<() => void>();
		const reducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		function visibleCards(): HTMLElement[] {
			return Array.from(
				grid.querySelectorAll<HTMLElement>("[data-tl-graph-card]"),
			);
		}

		function sizeSvg() {
			wiresSvg.setAttribute(
				"viewBox",
				`0 0 ${root.scrollWidth} ${root.scrollHeight}`,
			);
		}

		function rootRect() {
			return root.getBoundingClientRect();
		}

		function cardCenter(card: HTMLElement) {
			const r = card.getBoundingClientRect();
			const rr = rootRect();
			return {
				x: r.left - rr.left + r.width / 2,
				y: r.top - rr.top + r.height / 2,
			};
		}

		function makePath(d: string, cls: string, marker = true) {
			const p = document.createElementNS(NS, "path");
			p.setAttribute("d", d);
			p.setAttribute("class", cls);
			if (marker) p.setAttribute("marker-end", "url(#tl-graph-arrow)");
			return p;
		}

		/** 蛇形重排：偶数行左→右，奇数行视觉反转 */
		function layout() {
			const cards = visibleCards();
			if (cards.length === 0) return;
			const cols = Math.max(
				1,
				getComputedStyle(grid).gridTemplateColumns.split(" ").length,
			);
			cards.forEach((card, i) => {
				const row = Math.floor(i / cols);
				const col = i % cols;
				const visualCol = row % 2 === 0 ? col : cols - 1 - col;
				card.style.order = String(row * cols + visualCol);
			});
			drawRowArrows(cards, cols);
			clearHoverWires();
		}

		/** 行间回环箭头（时间线串联，平滑贝塞尔 + 端点圆点 + 流动虚线） */
		function drawRowArrows(cards: HTMLElement[], cols: number) {
			sizeSvg();
			wiresSvg
				.querySelectorAll("[data-row-arrow]")
				.forEach((n) => n.remove());
			wiresSvg
				.querySelectorAll("[data-row-node]")
				.forEach((n) => n.remove());
			const rows = Math.ceil(cards.length / cols);
			const rr = rootRect();
			for (let r = 0; r < rows - 1; r++) {
				const fromCard = cards[r * cols + cols - 1];
				const toCard = cards[(r + 1) * cols];
				if (!fromCard || !toCard) continue;
				const fr = fromCard.getBoundingClientRect();
				const tr = toCard.getBoundingClientRect();
				const fy = fr.top - rr.top + fr.height / 2;
				const ty = tr.top - rr.top + tr.height / 2;
				let d: string;
				let x1: number;
				let x2: number;
				if (r % 2 === 0) {
					// 左→右行：从右下出，绕右侧回环到下一行右上
					x1 = fr.right - rr.left + 8;
					x2 = tr.right - rr.left + 8;
					const out = Math.max(x1, x2) + 18;
					d = `M ${x1} ${fy} C ${out} ${fy} ${out} ${ty} ${x2} ${ty}`;
				} else {
					// 右→左行：从左下出，绕左侧回环到下一行左上
					x1 = fr.left - rr.left - 8;
					x2 = tr.left - rr.left - 8;
					const out = Math.min(x1, x2) - 18;
					d = `M ${x1} ${fy} C ${out} ${fy} ${out} ${ty} ${x2} ${ty}`;
				}
				const path = makePath(d, "tl-graph-wire tl-graph-wire--row");
				path.setAttribute("data-row-arrow", "");
				wiresSvg.appendChild(path);

				// 端点小圆点：起点（旧）为实心、终点（新）为空心
				const startDot = document.createElementNS(NS, "circle");
				startDot.setAttribute("class", "tl-graph-wire-node");
				startDot.setAttribute("data-row-node", "");
				startDot.setAttribute("cx", String(x1));
				startDot.setAttribute("cy", String(fy));
				startDot.setAttribute("r", "2.6");
				wiresSvg.appendChild(startDot);
				const endDot = document.createElementNS(NS, "circle");
				endDot.setAttribute("class", "tl-graph-wire-node is-end");
				endDot.setAttribute("data-row-node", "");
				endDot.setAttribute("cx", String(x2));
				endDot.setAttribute("cy", String(ty));
				endDot.setAttribute("r", "2.6");
				wiresSvg.appendChild(endDot);
			}
		}

		function clearHoverWires() {
			for (const cancel of wireAnims) cancel();
			wireAnims.clear();
			root
				.querySelectorAll("[data-hover-wire]")
				.forEach((n) => n.remove());
			root.classList.remove("is-hovering");
			root
				.querySelectorAll(".is-active, .is-linked")
				.forEach((c) => c.classList.remove("is-active", "is-linked"));
		}

		/** 悬停关联虚线：虚线逐渐「画」向终点，箭头随绘制推进，中点标签渐入 */
		function drawHoverWire(
			d: string,
			mid: { x: number; y: number },
			labelText: string,
		) {
			const path = makePath(d, "tl-graph-wire tl-graph-wire--hover", false);
			path.setAttribute("data-hover-wire", "");
			wiresSvg.appendChild(path);

			const label = document.createElement("span");
			label.className = "tl-graph-wire-label";
			label.textContent = labelText;
			label.setAttribute("data-hover-wire", "");
			label.style.left = `${mid.x}px`;
			label.style.top = `${mid.y}px`;
			root.appendChild(label);

			if (reducedMotion) {
				path.classList.add("is-drawn");
				path.setAttribute("marker-end", "url(#tl-graph-arrow)");
				label.classList.add("is-in");
				return;
			}

			const len = path.getTotalLength();
			const dur = Math.min(0.75, Math.max(0.35, len / 700));
			const DASH = 6;
			const GAP = 5;

			const revealDash = (drawn: number) => {
				const segments: number[] = [];
				let used = 0;
				let isDash = true;
				while (used < drawn) {
					const take = Math.min(isDash ? DASH : GAP, drawn - used);
					segments.push(take);
					used += take;
					isDash = !isDash;
				}
				if (segments.length === 0) segments.push(0);
				if (segments.length % 2 === 0) segments.push(0);
				segments.push(len + DASH + GAP);
				path.style.strokeDasharray = segments.join(" ");
			};

			const arrow = document.createElementNS(NS, "polygon");
			arrow.setAttribute("points", "-8.5,-4.5 0,0 -8.5,4.5");
			arrow.setAttribute("class", "tl-graph-wire-arrow");
			arrow.setAttribute("data-hover-wire", "");
			wiresSvg.appendChild(arrow);

			const easeOutCubic = (t: number) => 1 - (1 - t) ** 3;
			const start = performance.now();
			let raf = 0;
			const cancel = () => {
				cancelAnimationFrame(raf);
				arrow.remove();
			};
			wireAnims.add(cancel);

			const tick = (now: number) => {
				const t = Math.min(1, (now - start) / (dur * 1000));
				const drawn = len * easeOutCubic(t);
				revealDash(drawn);

				const tip = path.getPointAtLength(drawn);
				const back = path.getPointAtLength(Math.max(0, drawn - 1));
				const fwd = path.getPointAtLength(Math.min(len, drawn + 1));
				const deg =
					(Math.atan2(fwd.y - back.y, fwd.x - back.x) * 180) / Math.PI;
				arrow.setAttribute(
					"transform",
					`translate(${tip.x} ${tip.y}) rotate(${deg})`,
				);

				if (t < 1) {
					raf = requestAnimationFrame(tick);
					return;
				}
				wireAnims.delete(cancel);
				path.style.strokeDasharray = "";
				path.classList.add("is-drawn");
				path.setAttribute("marker-end", "url(#tl-graph-arrow)");
				arrow.remove();
				label.classList.add("is-in");
			};
			raf = requestAnimationFrame(tick);
		}

		function onCardEnter(card: HTMLElement) {
			clearHoverWires();
			sizeSvg();
			const links: { t: number; f: string }[] = JSON.parse(
				card.dataset.links || "[]",
			);
			const cardIndex = Number(card.dataset.index);
			const from = cardCenter(card);
			root.classList.add("is-hovering");
			card.classList.add("is-active");
			for (const link of links) {
				const target = root.querySelector<HTMLElement>(
					`[data-tl-graph-card][data-index="${link.t}"]`,
				);
				if (!target) continue;
				target.classList.add("is-linked");
				const to = cardCenter(target);
				const dx = to.x - from.x;
				const dy = to.y - from.y;
				const len = Math.hypot(dx, dy) || 1;
				const off = Math.min(56, len * 0.12);
				const cx = (from.x + to.x) / 2 - (dy / len) * off;
				const cy = (from.y + to.y) / 2 + (dx / len) * off;
				const mid = {
					x: from.x * 0.25 + cx * 0.5 + to.x * 0.25,
					y: from.y * 0.25 + cy * 0.5 + to.y * 0.25,
				};
				const labelText = link.f;
				const isNewer = link.t < cardIndex;
				const start = isNewer ? from : to;
				const end = isNewer ? to : from;
				drawHoverWire(
					`M ${start.x} ${start.y} Q ${cx} ${cy} ${end.x} ${end.y}`,
					mid,
					labelText,
				);
			}
		}

		function openDialog(card: HTMLElement) {
			const q = <T extends HTMLElement>(sel: string) =>
				dialog.querySelector<T>(sel)!;

			q("[data-dlg-num]").textContent = `#${card.dataset.num}`;
			const typeEl = q<HTMLElement>("[data-dlg-type]");
			typeEl.textContent =
				card.querySelector(".tl-graph-card__type")?.textContent || "";
			typeEl.dataset.type = card.dataset.type || "";
			const cardDate =
				card.querySelector<HTMLTimeElement>(".tl-graph-card__date");
			const dlgDate = q<HTMLTimeElement>("[data-dlg-date]");
			dlgDate.textContent = cardDate?.textContent || "";
			dlgDate.dateTime = cardDate?.dateTime || "";
			q("[data-dlg-title]").textContent =
				card.querySelector(".tl-graph-card__title")?.textContent || "";
			q("[data-dlg-detail]").innerHTML =
				card.querySelector(".tl-graph-card__detail-body")?.innerHTML || "";
			const hash = card.dataset.hash || "";
			const hashLink = q<HTMLAnchorElement>("[data-dlg-hash]");
			hashLink.textContent = hash ? `commit/${hash}` : "";
			hashLink.href = hash
				? `${root.dataset.repoUrl ?? ""}/commit/${hash}`
				: "";

			const links: { t: number; f: string }[] = JSON.parse(
				card.dataset.links || "[]",
			);
			const section = q<HTMLElement>("[data-dlg-related-section]");
			const list = q<HTMLElement>("[data-dlg-related]");
			list.innerHTML = "";
			if (links.length === 0) {
				section.hidden = true;
			} else {
				section.hidden = false;
				for (const link of links) {
					const target = root.querySelector<HTMLElement>(
						`[data-tl-graph-card][data-index="${link.t}"]`,
					);
					if (!target) continue;
					const li = document.createElement("li");
					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "tl-graph-dialog__related-btn";
					const numSpan = document.createElement("span");
					numSpan.className = "tl-graph-dialog__related-num";
					numSpan.textContent = `#${target.dataset.num}`;
					const titleSpan = document.createElement("span");
					titleSpan.className = "tl-graph-dialog__related-title";
					titleSpan.textContent =
						target.querySelector(".tl-graph-card__title")?.textContent || "";
					const filesSpan = document.createElement("span");
					filesSpan.className = "tl-graph-dialog__related-files";
					filesSpan.textContent = link.f;
					btn.appendChild(numSpan);
					btn.appendChild(titleSpan);
					btn.appendChild(filesSpan);
					btn.addEventListener("click", () => {
						closeDialog();
						target.scrollIntoView({ behavior: "smooth", block: "center" });
						target.classList.add("is-flash");
						setTimeout(() => target.classList.remove("is-flash"), 1300);
					});
					li.appendChild(btn);
					list.appendChild(li);
				}
			}

			dialog.hidden = false;
			document.documentElement.classList.add("tl-graph-dialog-open");
		}

		function closeDialog() {
			dialog.hidden = true;
			document.documentElement.classList.remove("tl-graph-dialog-open");
		}

		grid.addEventListener(
			"pointerover",
			(e) => {
				const card = (e.target as HTMLElement).closest?.(
					"[data-tl-graph-card]",
				) as HTMLElement | null;
				if (!card || card === activeCard) return;
				activeCard = card;
				onCardEnter(card);
			},
			{ signal },
		);
		grid.addEventListener(
			"pointerleave",
			() => {
				activeCard = null;
				clearHoverWires();
			},
			{ signal },
		);
		grid.addEventListener(
			"click",
			(e) => {
				const openBtn = (e.target as HTMLElement).closest?.(
					"[data-tl-graph-open]",
				);
				if (!openBtn) return;
				const card = openBtn.closest("[data-tl-graph-card]") as HTMLElement;
				if (card) openDialog(card);
			},
			{ signal },
		);
		dialog
			.querySelectorAll("[data-tl-graph-close]")
			.forEach((el) => el.addEventListener("click", closeDialog, { signal }));
		document.addEventListener(
			"keydown",
			(e) => {
				if (e.key === "Escape" && !dialog.hidden) closeDialog();
			},
			{ signal },
		);
		window.addEventListener("resize", layout, { signal });

		layout();
	}

	// 图形默认 hidden（尺寸为 0），首次显示时由页面派发事件触发初始化
	document.addEventListener("astro:page-load", initTimelineGraph);
	document.addEventListener("timeline:show-graph", initTimelineGraph);
</script>

