---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { getEnabledMoments } from "@/config/momentsConfig";
import { getTagList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const posts = await getCollection("posts", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});
const tags = await getTagList();
const moments = getEnabledMoments();

const stats = [
	{ label: "文章", count: posts.length },
	{ label: "标签", count: tags.length },
	{ label: "动态", count: moments.length },
];

// 主链接：跳转到关于页（参考站点为跳转主页）
const mainActionHref = url("/about/");
const mainActionLabel = "跳转主页";
const mainActionIcon = "material-symbols:home-rounded";

// 过滤掉用于主按钮的链接
const socialLinks = profileConfig.links.filter(
	(item) => item.name !== "Bilibili",
);
---

<div class="profile-card card-base p-4">
  <div class="profile-card__inner">
    <!-- Avatar (Circular) -->
    <a
      aria-label="Go to About Page"
      href={url("/about/")}
      class="profile-card__avatar"
    >
      <div class="profile-card__avatar-overlay">
        <Icon name="material-symbols:account-circle" class="profile-card__avatar-icon" />
      </div>
      <ImageWrapper
        src={profileConfig.avatar || ""}
        alt="Profile Image"
        class="profile-card__avatar-img"
        loading="eager"
        fetchpriority="high"
        widths={[150]}
        sizes="150px"
      />
    </a>

    <!-- Name and Bio -->
    <div class="profile-card__info">
      <div class="profile-card__name">
        {profileConfig.name}
      </div>
      <div class="profile-card__bio">
        {Array.isArray(profileConfig.bio) ? profileConfig.bio[1] || profileConfig.bio[0] : profileConfig.bio}
      </div>
    </div>

    <!-- Stats Row -->
    <div class="profile-card__stats">
      {stats.map(stat => (
        <div class="profile-card__stat">
          <div class="profile-card__stat-value">{stat.count}</div>
          <div class="profile-card__stat-label">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Main Action Button -->
    <a
      href={mainActionHref}
      class="profile-card__action"
    >
      <Icon name={mainActionIcon} class="profile-card__action-icon" />
      <span>{mainActionLabel}</span>
    </a>

    <!-- Social Icons -->
    <div class="profile-card__socials">
      {socialLinks.map(item => (
        <a
          rel="me"
          aria-label={item.name}
          href={item.url}
          target={item.url.startsWith("mailto:") ? "_self" : "_blank"}
          class="profile-card__social"
        >
          <Icon name={item.icon} class="profile-card__social-icon"></Icon>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .profile-card {
    --card-border: var(--moments-border);
    border: 1px solid var(--moments-border);
    background: var(--moments-surface);
    border-radius: clamp(1rem, 1.4vw, 1.2rem);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      0 10px 30px -28px rgba(15, 23, 42, 0.26);
    transition:
      transform 0.35s cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .profile-card:hover {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      0 14px 34px -30px rgba(15, 23, 42, 0.24);
  }
  :root.dark .profile-card {
    background: oklch(0.18 0 0 / 0.88);
  }

  .profile-card__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 头像 */
  .profile-card__avatar {
    position: relative;
    display: block;
    width: 6rem;
    height: 6rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    overflow: hidden;
    border: 2.5px solid var(--line-divider);
    background: var(--moments-soft);
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  }
  @media (hover: hover) {
    .profile-card__avatar:hover {
      transform: translateY(-3px) scale(1.04);
      box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.2);
    }
  }
  :root.dark .profile-card__avatar { border-color: rgb(46, 46, 46); }
  .profile-card__avatar:active { transform: scale(0.98); }
  .profile-card__avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .profile-card__avatar-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    transition: opacity 0.25s cubic-bezier(0.32, 0.72, 0, 1);
    pointer-events: none;
  }
  @media (hover: hover) {
    .profile-card__avatar:hover .profile-card__avatar-overlay { opacity: 1; }
  }
  .profile-card__avatar-icon {
    color: #fff;
    font-size: 1.75rem;
  }

  /* 名字 + 简介 */
  .profile-card__info {
    text-align: center;
    margin-bottom: 1rem;
  }
  .profile-card__name {
    color: var(--deep-text);
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .profile-card__bio {
    color: var(--content-meta);
    font-size: 0.8125rem;
    white-space: nowrap;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 统计 */
  .profile-card__stats {
    display: flex;
    width: 100%;
    justify-content: space-around;
    padding: 0.875rem 0;
    margin: 0.25rem 0 1rem;
    border-top: 1px solid var(--moments-border);
    border-bottom: 1px solid var(--moments-border);
  }
  .profile-card__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }
  .profile-card__stat-value {
    color: var(--deep-text);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .profile-card__stat-label {
    color: var(--content-meta);
    font-size: 0.75rem;
    margin-top: 0.25rem;
  }

  /* 主按钮 */
  .profile-card__action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    width: 100%;
    padding: 0.5rem 1rem;
    margin-bottom: 1rem;
    color: var(--page-bg);
    background: var(--deep-text);
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .profile-card__action:hover { opacity: 0.85; }
  .profile-card__action:active { transform: scale(0.98); }
  .profile-card__action-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* 社交图标 */
  .profile-card__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    justify-content: center;
  }
  .profile-card__social {
    color: var(--content-meta);
    text-decoration: none;
    transition: color 0.2s, transform 0.2s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .profile-card__social:hover {
    color: var(--deep-text);
    transform: scale(1.15);
  }
  .profile-card__social:active { transform: scale(0.92); }
  .profile-card__social-icon {
    font-size: 1.2rem;
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
