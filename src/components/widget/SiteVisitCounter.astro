---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
---

<WidgetLayout name={i18n(I18nKey.pageViews) || "访问统计"} id="site-visit-counter">
  <div class="flex flex-col items-center py-3">
    <div class="flex items-baseline gap-1">
      <span class="visit-count" id="site-visit-total">--</span>
      <span class="visit-label">次</span>
    </div>
    <p class="visit-desc">站点总访问量</p>
  </div>
</WidgetLayout>

<style>
  .visit-count {
    font-size: 1.75rem;
    font-weight: 800;
    font-family: ui-monospace, SFMono-Regular, 'Cascadia Code', monospace;
    font-variant-numeric: tabular-nums;
    color: var(--deep-text);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .visit-label {
    font-size: 0.75rem;
    color: var(--content-meta);
    font-weight: 600;
  }
  .visit-desc {
    font-size: 0.6875rem;
    color: var(--content-meta);
    margin-top: 0.5rem;
  }
</style>

<script is:inline>
  (function() {
    var countEl = document.getElementById('site-visit-total');
    if (!countEl) return;

    // Umami 统计（公开分享链接鉴权：先取 share token，再查全站 stats）
    var UMAMI_HOST = 'https://umami.fqzlr.com';
    var UMAMI_SHARE = 'kHCJG2ZUL1r6q5Js';

    function fetchTotal() {
      fetch(UMAMI_HOST + '/api/share/' + UMAMI_SHARE, { cache: 'no-store' })
        .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function(share) {
          var end = Date.now();
          return fetch(UMAMI_HOST + '/api/websites/' + share.websiteId + '/stats?startAt=0&endAt=' + end, {
            headers: {
              'x-umami-share-token': share.token,
              'x-umami-share-context': '1',
            },
          }).then(function(r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          });
        })
        .then(function(stats) {
          var pv = Number(stats && stats.pageviews);
          countEl.textContent = Number.isFinite(pv) && pv > 0 ? pv.toLocaleString() : '--';
        })
        .catch(function() {
          countEl.textContent = '--';
        });
    }

    fetchTotal();
    // swup/astro 页面切换后重新拉取
    document.addEventListener('astro:page-load', function() {
      var el = document.getElementById('site-visit-total');
      if (el && el.textContent === '--') fetchTotal();
    });
  })();
</script>
