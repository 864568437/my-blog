---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
---

<WidgetLayout name={i18n(I18nKey.pageViews) || "访问统计"} id="site-visit-counter">
  <div class="flex flex-col items-center py-3">
    <div class="flex items-baseline gap-1">
      <span class="visit-count" id="site-visit-total">--</span>
      <span class="visit-label">次</span>
    </div>
    <p class="visit-desc">站点总访问量</p>
  </div>
</WidgetLayout>

<style>
  .visit-count {
    font-size: 1.75rem;
    font-weight: 800;
    font-family: ui-monospace, SFMono-Regular, 'Cascadia Code', monospace;
    font-variant-numeric: tabular-nums;
    color: var(--deep-text);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .visit-label {
    font-size: 0.75rem;
    color: var(--content-meta);
    font-weight: 600;
  }
  .visit-desc {
    font-size: 0.6875rem;
    color: var(--content-meta);
    margin-top: 0.5rem;
  }
</style>

<script is:inline>
  (function() {
    var countEl = document.getElementById('site-visit-total');
    if (!countEl) return;

    var walineURL = 'https://waline.fqzlr.com';

    // 主要路径列表
    var paths = ['/', '/posts/', '/guestbook/', '/moments/', '/gallery/', '/bangumi/', '/projects/', '/friends/', '/timeline/'];

    /** 带重试和超时的 fetch 封装 */
    function fetchWithRetry(url, retries, timeout) {
      retries = retries || 2;
      timeout = timeout || 5000;
      return new Promise(function(resolve, reject) {
        var attempt = 0;
        function doFetch() {
          var controller = new AbortController();
          var timer = setTimeout(function() { controller.abort(); }, timeout);
          fetch(url, { signal: controller.signal })
            .then(function(res) {
              clearTimeout(timer);
              resolve(res);
            })
            .catch(function(err) {
              clearTimeout(timer);
              attempt++;
              if (attempt <= retries) {
                setTimeout(doFetch, 500 * attempt);
              } else {
                reject(err);
              }
            });
        }
        doFetch();
      });
    }

    function fetchTotal() {
      var promises = paths.map(function(path) {
        return fetchWithRetry(walineURL + '/api/page?path=' + encodeURIComponent(path))
          .then(function(res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
          })
          .then(function(data) {
            var arr = Array.isArray(data) ? data : (data && data.data ? data.data : []);
            var item = arr && arr.length > 0 ? arr[0] : null;
            return item && item.views != null ? Number(item.views) : 0;
          })
          .catch(function() { return 0; });
      });

      Promise.all(promises).then(function(counts) {
        var total = counts.reduce(function(sum, c) { return sum + c; }, 0);
        if (total > 0 && countEl) {
          countEl.textContent = total.toLocaleString();
        } else if (countEl) {
          countEl.textContent = '--';
        }
      });
    }

    fetchTotal();
  })();
</script>
