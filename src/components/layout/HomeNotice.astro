---
/**
 * HomeNotice.astro —— 首页「线条公告」
 * --------------------------------------------------------------
 * 参考页样式适配：1px 虚线边框（主题色）+ 圆角容器 + 左侧灯泡图标
 * （呼吸缩放动画）+ 右侧多行公告文本（行高 30px）。
 * 内容复用侧边栏公告的同一数据源 content/ziyuan/announcement.md，
 * 按 content 中的换行拆分为多条 notice-item（单行则只显示一条），
 * 公告内容为空时整个组件不渲染（关了就干净消失）。
 */
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import "@/styles/components/home-notice.css";

const ziyuanEntries = await getCollection("ziyuan");
const announcementEntry = ziyuanEntries.find((e) => e.id === "announcement");
const announcementData = announcementEntry?.data as any;

// 按换行拆分为多条公告；空行过滤
const noticeItems: string[] = String(announcementData?.content ?? "")
	.split(/\r?\n/)
	.map((line: string) => line.trim())
	.filter((line: string) => line.length > 0);

// 无公告内容时不渲染
const shouldRender = noticeItems.length > 0;
---

{
	shouldRender && (
		<aside class="home-notice" aria-label="站点公告">
			<div class="home-notice__inner">
				<div class="home-notice__card">
					<Icon
						name="material-symbols:lightbulb"
						class="home-notice__icon"
						aria-hidden="true"
					/>
					<div class="home-notice__wrap">
						{noticeItems.map((item) => (
							<p class="home-notice__item">{item}</p>
						))}
					</div>
				</div>
			</div>
		</aside>
	)
}
