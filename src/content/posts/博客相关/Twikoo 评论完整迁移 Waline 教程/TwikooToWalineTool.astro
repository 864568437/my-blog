---
// Twikoo ↔ Waline 双向转换工具（内嵌交互式组件）
---

<div class="twk2wal-tool">
  <div class="twk2wal-box">
    <h3 class="twk2wal-title">Twikoo ↔ Waline 双向转换器</h3>
    <p class="twk2wal-desc">
      1. 粘贴 JSON 数据或上传文件<br />
      2. 自动给 url 末尾加 <code>/</code>（Twikoo→Waline 方向）<br />
      3. 完整保留多级嵌套回复关系，支持双向互转
    </p>

    <!-- 方向切换 -->
    <div class="twk2wal-mode-switch">
      <button id="twk2wal-modeTW" class="twk2wal-mode-btn active">Twikoo → Waline</button>
      <button id="twk2wal-modeWT" class="twk2wal-mode-btn">Waline → Twikoo</button>
    </div>

    <textarea id="twk2wal-input" class="twk2wal-textarea" placeholder="粘贴 Twikoo 完整导出 JSON 数组..."></textarea>
    <div class="twk2wal-url-fix">
      <span>批量替换 url 前缀：</span>
      <input id="twk2wal-oldUrl" class="twk2wal-input" placeholder="原路径前缀，如 /post/" />
      <input id="twk2wal-newUrl" class="twk2wal-input" placeholder="新路径前缀，如 /archives/" />
      <button id="twk2wal-fixUrlBtn" class="twk2wal-btn twk2wal-btn--warn">一键替换全部 url</button>
    </div>
    <div class="twk2wal-btns">
      <button id="twk2wal-uploadBtn" class="twk2wal-btn twk2wal-btn--blue">上传本地 JSON</button>
      <button id="twk2wal-convertBtn" class="twk2wal-btn twk2wal-btn--green">开始转换</button>
      <button id="twk2wal-downloadBtn" class="twk2wal-btn twk2wal-btn--purple" disabled>下载结果 JSON</button>
      <button id="twk2wal-clearBtn" class="twk2wal-btn twk2wal-btn--red">清空全部</button>
    </div>
    <p id="twk2wal-msg" class="twk2wal-tip"></p>
  </div>

  <div class="twk2wal-box">
    <h3 class="twk2wal-subtitle">转换结果预览</h3>
    <textarea id="twk2wal-output" class="twk2wal-textarea" readonly placeholder="转换后标准 JSON"></textarea>
  </div>

  <input type="file" id="twk2wal-fileInput" accept=".json" style="display:none" />
</div>

<style>
  .twk2wal-tool { margin: 1.5rem 0; }
  .twk2wal-box {
    background: var(--float-panel-bg);
    border: 1px solid var(--line-divider);
    border-radius: var(--radius-medium);
    padding: 1.25rem;
    margin-bottom: 1rem;
  }
  .twk2wal-title {
    font-size: 1.15rem; font-weight: 600;
    margin-bottom: 0.5rem; color: var(--deep-text);
  }
  .twk2wal-subtitle {
    font-size: 1rem; font-weight: 600;
    margin-bottom: 0.5rem; color: var(--deep-text);
  }
  .twk2wal-desc {
    color: var(--content-meta); font-size: 0.85rem;
    line-height: 1.7; margin-bottom: 0.75rem;
  }
  .twk2wal-desc code {
    background: var(--inline-code-bg);
    padding: 0.1em 0.35em; border-radius: 4px; font-size: 0.85em;
  }
  .twk2wal-mode-switch {
    display: flex; gap: 0; margin-bottom: 1rem;
    border-radius: 8px; overflow: hidden;
    border: 2px solid var(--primary);
  }
  .twk2wal-mode-btn {
    flex: 1; padding: 0.5rem 0.75rem; border: none;
    font-size: 0.85rem; font-weight: 600; cursor: pointer;
    background: var(--float-panel-bg); color: var(--primary);
    transition: all 0.2s;
  }
  .twk2wal-mode-btn.active {
    background: var(--primary); color: #fff;
  }
  .twk2wal-mode-btn:hover:not(.active) {
    background: var(--inline-code-bg);
  }
  .twk2wal-textarea {
    width: 100%; min-height: 200px; padding: 0.75rem;
    border: 1px solid var(--line-divider);
    border-radius: var(--radius-small);
    background: var(--codeblock-bg); color: var(--deep-text);
    font-family: monospace; font-size: 0.8rem;
    line-height: 1.5; resize: vertical;
  }
  .twk2wal-textarea:focus { outline: none; border-color: var(--primary); }
  .twk2wal-url-fix {
    margin: 0.75rem 0; display: flex; gap: 0.5rem;
    align-items: center; flex-wrap: wrap;
  }
  .twk2wal-url-fix span {
    font-size: 0.85rem; color: var(--deep-text); white-space: nowrap;
  }
  .twk2wal-input {
    padding: 0.4rem 0.6rem; border: 1px solid var(--line-divider);
    border-radius: var(--radius-small);
    background: var(--float-panel-bg); color: var(--deep-text);
    font-size: 0.8rem; min-width: 10rem; flex: 1;
  }
  .twk2wal-input:focus { outline: none; border-color: var(--primary); }
  .twk2wal-btns {
    margin: 0.75rem 0; display: flex; gap: 0.5rem; flex-wrap: wrap;
  }
  .twk2wal-btn {
    padding: 0.5rem 1rem; border: none;
    border-radius: var(--radius-small); cursor: pointer;
    font-size: 0.8rem; color: #fff; transition: opacity 0.15s ease;
  }
  .twk2wal-btn:hover:not(:disabled) { opacity: 0.85; }
  .twk2wal-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .twk2wal-btn--blue { background: #3b82f6; }
  .twk2wal-btn--green { background: #10b981; }
  .twk2wal-btn--purple { background: #8b5cf6; }
  .twk2wal-btn--red { background: #ef4444; }
  .twk2wal-btn--warn { background: #f59e0b; }
  .twk2wal-tip {
    margin-top: 0.4rem; font-size: 0.8rem;
    color: var(--content-meta); min-height: 1.2rem;
  }
  .twk2wal-tip.twk2wal-success { color: #059669; font-weight: 500; }
  :global(html.dark) .twk2wal-tip.twk2wal-success { color: #34d399; }
  .twk2wal-tip.twk2wal-error { color: #dc2626; }
  :global(html.dark) .twk2wal-tip.twk2wal-error { color: #f87171; }
</style>

<script>
  type TwalineJson = {
    type: string;
    version: number;
    time: number;
    tables: string[];
    data: {
      Comment: Record<string, unknown>[];
      Counter: unknown[];
      Users: unknown[];
    };
  };

  function generateUUID(): string {
    return 'xxxxxxxxxxxx4xxxyxxxxxxxxxxxxxxx'.replace(/[xy]/g, c => {
      const r = Math.random() * 16 | 0;
      return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
  }

  function stripHtml(html: string): string {
    const div = document.createElement('div');
    div.innerHTML = html;
    return div.textContent || div.innerText || '';
  }

  function tsToISO(ms: number): string {
    return new Date(ms).toISOString();
  }

  function isoToTs(iso: string): number {
    return new Date(iso).getTime();
  }

  function normalizeUrl(path: string | undefined): string {
    let url = path?.trim() || '/';
    if (url === '/') return url;
    if (!url.endsWith('/')) url += '/';
    return url;
  }

  function wrapHtml(text: string): string {
    if (!text || text.trim() === '') return '';
    return '<p>' + text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '</p>\n<p>') + '</p>\n';
  }

  function convertTW2WL(data: any) {
    const comments = Array.isArray(data) ? data : (data.data || data.comments || data);
    if (!Array.isArray(comments) || comments.length === 0) throw new Error('未识别到评论数组');

    let nextId = 1;
    const idMap: Record<string, number> = {};
    for (const c of comments) { idMap[c._id] = nextId++; }

    const userMap: Record<string, number> = {};
    const users: any[] = [];
    let uidCounter = 0;
    const usedEmails = new Set<string>();

    for (const c of comments) {
      const email = (c.mail || '').trim().toLowerCase();
      if (email && !usedEmails.has(email)) {
        usedEmails.add(email);
        uidCounter++;
        userMap[email] = uidCounter;
        users.push({
          objectId: uidCounter, display_name: c.nick || '', email,
          password: '', type: c.master === 1 ? 'administrator' : 'guest',
          label: c.master === 1 ? '主理人' : null, url: c.link || null,
          avatar: c.avatar || null,
          github: null, twitter: null, facebook: null, google: null,
          weibo: null, qq: null, oidc: null, huawei: null, "2fa": null,
          createdAt: tsToISO(c.created), updatedAt: tsToISO(c.updated || c.created)
        });
      }
    }

    const urlCountMap: Record<string, number> = {};
    for (const c of comments) {
      const url = normalizeUrl(c.url);
      urlCountMap[url] = (urlCountMap[url] || 0) + 1;
    }
    const counters: any[] = [];
    let cid = 0;
    for (const [url, count] of Object.entries(urlCountMap)) {
      cid++;
      counters.push({
        objectId: cid, url, time: count,
        reaction0: null, reaction1: null, reaction2: null,
        reaction3: null, reaction4: null, reaction5: null,
        reaction6: null, reaction7: null, reaction8: null,
        createdAt: tsToISO(Date.now()), updatedAt: tsToISO(Date.now())
      });
    }

    const walineComments: any[] = [];
    for (const c of comments) {
      const email = (c.mail || '').trim().toLowerCase();
      const userId = userMap[email] || 0;
      let pid: number | null = null, rid: number | null = null;
      if (c.pid && c.pid.trim() !== '') pid = idMap[c.pid] || null;
      if (c.rid && c.rid.trim() !== '') rid = idMap[c.rid] || null;
      if (pid !== null && rid === null) rid = pid;

      walineComments.push({
        objectId: idMap[c._id], user_id: userId,
        comment: stripHtml(c.comment || ''), ip: c.ip || '',
        link: c.link || null, mail: c.mail || '', nick: c.nick || '',
        pid, rid,
        sticky: c.top === 1 ? 1 : null,
        status: c.isSpam ? 'spam' : 'approved', like: null,
        ua: c.ua || '', url: normalizeUrl(c.url),
        insertedAt: tsToISO(c.created),
        createdAt: tsToISO(c.created),
        updatedAt: tsToISO(c.updated || c.created)
      });
    }

    return {
      __version: '1.41.3', type: 'waline', version: 1, time: Date.now(),
      tables: ['Comment', 'Counter', 'Users'],
      data: { Comment: walineComments, Counter: counters, Users: users }
    };
  }

  function convertWL2TW(data: any) {
    let walineObj = data;
    if (Array.isArray(data)) walineObj = { data: { Comment: data, Users: [], Counter: [] } };
    const wlComments = walineObj?.data?.Comment || walineObj?.Comment || walineObj?.comments || [];
    const wlUsers = walineObj?.data?.Users || walineObj?.Users || [];
    if (!Array.isArray(wlComments) || wlComments.length === 0) throw new Error('未识别到 Waline Comment 数据');

    const userInfoMap: Record<number, any> = {};
    for (const u of wlUsers) { userInfoMap[u.objectId] = u; }

    const idMap: Record<number, string> = {};
    for (const c of wlComments) { idMap[c.objectId] = generateUUID(); }

    const twikooComments: any[] = [];
    for (const c of wlComments) {
      const userInfo = userInfoMap[c.user_id] || {};
      const email = c.mail || userInfo.email || '';
      const nick = c.nick || userInfo.display_name || '';
      let pid = '', rid = '';
      if (c.pid != null) pid = idMap[c.pid] || '';
      if (c.rid != null) rid = idMap[c.rid] || '';

      const created = typeof c.createdAt === 'number' ? c.createdAt : isoToTs(c.createdAt || c.insertedAt || new Date().toISOString());
      const updated = typeof c.updatedAt === 'number' ? c.updatedAt : isoToTs(c.updatedAt || c.createdAt || new Date().toISOString());

      twikooComments.push({
        _id: idMap[c.objectId], uid: '', nick, mail: email, mailMd5: '',
        link: c.link || userInfo.url || '', ua: c.ua || '', ip: c.ip || '',
        ipRegion: '', master: (userInfo.type === 'administrator') ? 1 : 0,
        url: c.url || '/', href: '',
        comment: wrapHtml(c.comment || ''), pid, rid,
        isSpam: c.status === 'spam' ? 1 : 0,
        created, updated,
        like: c.like ? JSON.stringify(c.like) : '[]',
        top: c.sticky ? 1 : 0, avatar: userInfo.avatar || ''
      });
    }
    return twikooComments;
  }

  function init() {
    const inputEl = document.getElementById('twk2wal-input') as HTMLTextAreaElement | null;
    const outputEl = document.getElementById('twk2wal-output') as HTMLTextAreaElement | null;
    const msgEl = document.getElementById('twk2wal-msg');
    const uploadBtn = document.getElementById('twk2wal-uploadBtn');
    const convertBtn = document.getElementById('twk2wal-convertBtn');
    const downloadBtn = document.getElementById('twk2wal-downloadBtn') as HTMLButtonElement | null;
    const clearBtn = document.getElementById('twk2wal-clearBtn');
    const fixUrlBtn = document.getElementById('twk2wal-fixUrlBtn');
    const oldUrlInput = document.getElementById('twk2wal-oldUrl') as HTMLInputElement | null;
    const newUrlInput = document.getElementById('twk2wal-newUrl') as HTMLInputElement | null;
    const fileInput = document.getElementById('twk2wal-fileInput') as HTMLInputElement | null;
    const modeTW = document.getElementById('twk2wal-modeTW');
    const modeWT = document.getElementById('twk2wal-modeWT');

    if (!inputEl || !outputEl || !msgEl || !uploadBtn || !convertBtn || !downloadBtn || !clearBtn || !fixUrlBtn || !oldUrlInput || !newUrlInput || !fileInput || !modeTW || !modeWT) return;

    let currentMode: 'tw2wl' | 'wl2tw' = 'tw2wl';
    let outputData: any = null;

    const showMsg = (text: string, type: 'success' | 'error' | '') => {
      msgEl!.textContent = text;
      msgEl!.className = 'twk2wal-tip' + (type ? ' twk2wal-' + type : '');
    };

    const setMode = (mode: 'tw2wl' | 'wl2tw') => {
      currentMode = mode;
      modeTW.classList.toggle('active', mode === 'tw2wl');
      modeWT.classList.toggle('active', mode === 'wl2tw');
      inputEl.placeholder = mode === 'tw2wl' ? '粘贴 Twikoo 完整导出 JSON 数组...' : '粘贴 Waline 导出 JSON 对象...';
      inputEl.value = outputEl.value = '';
      outputData = null;
      downloadBtn.disabled = true;
      showMsg('', '');
    };

    modeTW.onclick = () => setMode('tw2wl');
    modeWT.onclick = () => setMode('wl2tw');

    uploadBtn.onclick = () => fileInput.click();
    fileInput.onchange = async (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      if (!f) return;
      inputEl.value = await f.text();
      showMsg(`已加载文件：${f.name}`, 'success');
    };

    clearBtn.onclick = () => {
      inputEl.value = outputEl.value = '';
      oldUrlInput.value = newUrlInput.value = '';
      outputData = null;
      downloadBtn.disabled = true;
      showMsg('', '');
    };

    fixUrlBtn.onclick = () => {
      if (!outputData || currentMode !== 'tw2wl') {
        showMsg(currentMode === 'wl2tw' ? 'Waline→Twikoo 方向无需替换路径前缀' : '请先执行转换', 'error');
        return;
      }
      const oldPre = oldUrlInput.value.trim();
      const newPre = newUrlInput.value.trim();
      if (!oldPre || !newPre) { showMsg('请填写原路径和新路径前缀', 'error'); return; }
      let count = 0;
      outputData.data.Comment.forEach((item: any) => {
        if (item.url.includes(oldPre)) { item.url = normalizeUrl(item.url.replace(oldPre, newPre)); count++; }
      });
      outputEl.value = JSON.stringify(outputData, null, 2);
      showMsg(`路径替换完成，共修改 ${count} 条评论 url`, 'success');
    };

    convertBtn.onclick = () => {
      try {
        const raw = inputEl.value.trim();
        if (!raw) throw '输入内容不能为空';
        const parsed = JSON.parse(raw);

        if (currentMode === 'tw2wl') {
          outputData = convertTW2WL(parsed);
        } else {
          outputData = convertWL2TW(parsed);
        }

        outputEl.value = JSON.stringify(outputData, null, 2);
        downloadBtn.disabled = false;
        const count = currentMode === 'tw2wl' ? outputData.data.Comment.length : outputData.length;
        const extra = currentMode === 'tw2wl' ? '，已自动补 url 尾斜杠' : '';
        showMsg(`转换成功，共 ${count} 条评论${extra}`, 'success');
      } catch (err) {
        outputEl.value = '';
        outputData = null;
        downloadBtn.disabled = true;
        showMsg('转换失败：' + err, 'error');
      }
    };

    downloadBtn.onclick = () => {
      if (!outputData) { showMsg('请先执行转换！', 'error'); return; }
      const filename = currentMode === 'tw2wl' ? 'waline-import.json' : 'twikoo-export.json';
      const jsonStr = JSON.stringify(outputData, null, 2);
      const blob = new Blob([jsonStr], { type: 'application/json;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click();
      document.body.removeChild(a); URL.revokeObjectURL(url);
      showMsg(`文件下载完成：${filename}`, 'success');
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
